{
  "format": 1,
  "about": "Toolchain layers: Debian packages prebuilt on top of the streamed base rootfs (docs/DEBIAN.md \"Toolchain layers\"). scripts/debian/build-layers.sh builds them; src/debian/layers.ts applies them; `toolchain install ID` applies one.",
  "layers": {
    "c": {
      "title": "C and C++",
      "description": "gcc, g++, make, cmake, gdb, pkg-config (build-essential)",
      "packages": [
        "build-essential",
        "gdb",
        "make",
        "cmake",
        "pkg-config"
      ],
      "check": "printf '#include <stdio.h>\\nint main(void){puts(\"hello\");return 0;}\\n' > /tmp/tc-hello.c && gcc -o /tmp/tc-hello /tmp/tc-hello.c && /tmp/tc-hello"
    },
    "python": {
      "title": "Python 3",
      "description": "python3, pip, venv, dev headers, numpy, requests, yaml",
      "packages": [
        "python3",
        "python3-pip",
        "python3-venv",
        "python3-dev",
        "python3-setuptools",
        "python3-wheel",
        "python3-requests",
        "python3-numpy",
        "python3-yaml"
      ],
      "check": "python3 -c 'import json, venv, numpy; print(json.dumps([1]))'"
    },
    "node": {
      "title": "Node.js",
      "description": "Debian's nodejs and npm",
      "packages": [
        "nodejs",
        "npm"
      ],
      "check": "/usr/bin/node -e 'console.log(1+1)'"
    },
    "java": {
      "title": "Java",
      "description": "OpenJDK (default-jdk-headless): java, javac, jar",
      "packages": [
        "default-jdk-headless"
      ],
      "check": "javac -version"
    },
    "classic": {
      "title": "Classic languages",
      "description": "Fortran (gfortran), COBOL (gnucobol), Pascal (fpc), Ada (gnat)",
      "packages": [
        "gfortran",
        "gnucobol",
        "fp-compiler",
        "fp-units-rtl",
        "gnat"
      ],
      "check": "gfortran --version && cobc --version && fpc -iV && gnatmake --version"
    },
    "tex": {
      "title": "LaTeX",
      "description": "TeX Live (texlive-latex-recommended) and latexmk",
      "packages": [
        "texlive-latex-recommended",
        "latexmk"
      ],
      "check": "kpsewhich article.cls"
    }
  }
}
