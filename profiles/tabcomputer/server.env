# Environment for server.mjs on tabcomputer.com (systemd EnvironmentFile; the
# tabcomputer profile, docs/PROFILES.md).
# Shipped with every release; no secrets here, this repo is public.
# TABCOMPUTER_* names.

# Raw TCP relay at /tcp for guest sockets (docs/NETWORKING.md). Open for now;
# set TABCOMPUTER_TCP_REQUIRE_SIGNIN=1 to require a GitHub sign-in (docs/DESKTOP.md).
TABCOMPUTER_TCP_RELAY=1
TABCOMPUTER_TCP_ORIGINS=https://tabcomputer.com,https://www.tabcomputer.com
TABCOMPUTER_TCP_REQUIRE_SIGNIN=0
# Tokens not tied to the fetching IP: proxy pools, iCloud Private Relay and
# dual-stack clients change IP between the token fetch and each connection.
TABCOMPUTER_TCP_TOKEN_BIND_IP=0
# Toolchain layers (`toolchain install`), built in the background by
# release.sh into this directory (docs/DEBIAN.md "Toolchain layers")
TABCOMPUTER_DEBIAN_LAYERS=/opt/tabcomputer/layers
