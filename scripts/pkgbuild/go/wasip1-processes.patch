+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build wasip1
+
+package os
+
+import (
+	"syscall"
+	"time"
+)
+
+// wait4 polls: wasip1 has one thread, so a blocking wait would also stop
+// the goroutines copying the child's output (and the child with them,
+// once a pipe fills).
+func wait4(pid int, status *syscall.WaitStatus, rusage *syscall.Rusage) (int, error) {
+	d := 100 * time.Microsecond
+	for {
+		pid1, err := syscall.Wait4(pid, status, syscall.WNOHANG, rusage)
+		if err != nil || pid1 != 0 {
+			return pid1, err
+		}
+		time.Sleep(d)
+		if d < 20*time.Millisecond {
+			d *= 2
+		}
+	}
+}
