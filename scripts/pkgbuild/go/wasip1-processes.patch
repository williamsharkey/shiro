+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build wasip1
+
+// Processes for wasip1 on runtimes that provide the WASIX process calls
+// (Shiro's kernel: proc_spawn3, proc_join, fd_pipe). Elsewhere the imports
+// are missing or return ENOSYS, as StartProcess did before.
+
+package syscall
+
+import "unsafe"
+
+//go:wasmimport wasix_32v1 proc_spawn3
+//go:noescape
+func proc_spawn3(name unsafe.Pointer, nameLen uint32, argv unsafe.Pointer, argc uint32, envp unsafe.Pointer, envc uint32,
+	fdops unsafe.Pointer, fdopsLen uint32, signals unsafe.Pointer, signalsLen uint32, searchPath uint32,
+	path unsafe.Pointer, pathLen uint32, retPid unsafe.Pointer) Errno
+
+//go:wasmimport wasix_32v1 proc_join
+//go:noescape
+func proc_join(pid unsafe.Pointer, flags uint32, status unsafe.Pointer) Errno
+
+//go:wasmimport wasix_32v1 fd_pipe
+//go:noescape
+func fd_pipe(r unsafe.Pointer, w unsafe.Pointer) Errno
+
+const WNOHANG = 0x1
+
+// cstrings returns NUL-terminated copies of ss and a table of their
+// 32-bit addresses (wasm32 pointers), as proc_spawn3 takes them.
+func cstrings(ss []string) ([][]byte, []uint32) {
+	bufs := make([][]byte, len(ss))
+	ptrs := make([]uint32, len(ss)+1)
+	for i, s := range ss {
+		b := make([]byte, len(s)+1)
+		copy(b, s)
+		bufs[i] = b
+		ptrs[i] = uint32(uintptr(unsafe.Pointer(&b[0])))
+	}
+	return bufs, ptrs
+}
+
+func ptr32(b []byte) uint32 {
+	if len(b) == 0 {
+		return 0
+	}
+	return uint32(uintptr(unsafe.Pointer(&b[0])))
+}
+
+// ProcSpawnFdOp: cmd u8, fd u32 @4, src_fd u32 @8, name ptr @12, name len @16
+// (56 bytes). Commands: 0 close, 1 dup2, 3 chdir.
+func fdop(buf []byte, cmd byte, fd, src uint32, name []byte) {
+	buf[0] = cmd
+	put32 := func(off int, v uint32) {
+		buf[off], buf[off+1], buf[off+2], buf[off+3] = byte(v), byte(v>>8), byte(v>>16), byte(v>>24)
+	}
+	put32(4, fd)
+	put32(8, src)
+	put32(12, ptr32(name))
+	put32(16, uint32(len(name)))
+}
+
+func StartProcess(argv0 string, argv []string, attr *ProcAttr) (pid int, handle uintptr, err error) {
+	if attr == nil {
+		attr = &ProcAttr{}
+	}
+	// Our cwd is ours alone (see Chdir), so the child is told where to start,
+	// and $PWD (which the wasip1 runtime trusts) follows.
+	dir := attr.Dir
+	if dir == "" {
+		dir = cwd
+	} else if dir[0] != '/' {
+		dir = joinPath(cwd, dir)
+	}
+	env := attr.Env
+	if env != nil {
+		env = append([]string{}, env...)
+		found := false
+		for i, kv := range env {
+			if len(kv) >= 4 && kv[:4] == "PWD=" {
+				env[i] = "PWD=" + dir
+				found = true
+			}
+		}
+		if !found {
+			env = append(env, "PWD="+dir)
+		}
+	}
+
+	name := []byte(argv0)
+	argBufs, argPtrs := cstrings(argv)
+	envBufs, envPtrs := cstrings(env)
+	dirName := []byte(dir)
+
+	// The child gets exactly attr.Files: a close of fd 0xffffffff asks the
+	// runtime not to inherit anything else (wasip1 has no close-on-exec, so
+	// otherwise every child kept every pipe Go had open).
+	const opSize = 56
+	ops := make([]byte, opSize*(len(attr.Files)+2))
+	n := 0
+	fdop(ops[0:opSize], 3, 0, 0, dirName)
+	n++
+	fdop(ops[opSize:2*opSize], 0, 0xffffffff, 0, nil)
+	n++
+	for i, f := range attr.Files {
+		if f == ^uintptr(0) {
+			continue
+		}
+		fdop(ops[n*opSize:(n+1)*opSize], 1, uint32(i), uint32(f), nil)
+		n++
+	}
+
+	var envp unsafe.Pointer
+	if env != nil {
+		envp = unsafe.Pointer(&envPtrs[0])
+	}
+	var child uint32
+	errno := proc_spawn3(unsafe.Pointer(&name[0]), uint32(len(name)), unsafe.Pointer(&argPtrs[0]), uint32(len(argv)),
+		envp, uint32(len(env)), unsafe.Pointer(&ops[0]), uint32(n), nil, 0, 0, nil, 0, unsafe.Pointer(&child))
+	keepAlive(argBufs)
+	keepAlive(envBufs)
+	keepAlive(name)
+	keepAlive(dirName)
+	if errno != 0 {
+		return 0, 0, errno
+	}
+	return int(child), 0, nil
+}
+
+//go:noinline
+func keepAlive(x any) {}
+
+func Wait4(pid int, wstatus *WaitStatus, options int, rusage *Rusage) (wpid int, err error) {
+	// OptionPid {tag u8, pid u32 @4}; JoinStatus {tag u8, code u16 @2, signal u8 @4}
+	var p [8]byte
+	var st [8]byte
+	if pid > 0 {
+		p[0] = 1
+		p[4], p[5], p[6], p[7] = byte(pid), byte(pid>>8), byte(pid>>16), byte(pid>>24)
+	}
+	flags := uint32(0)
+	if options&WNOHANG != 0 {
+		flags = 1
+	}
+	if errno := proc_join(unsafe.Pointer(&p[0]), flags, unsafe.Pointer(&st[0])); errno != 0 {
+		return 0, errno
+	}
+	if rusage != nil {
+		*rusage = Rusage{}
+	}
+	if p[0] == 0 {
+		return 0, nil // WNOHANG: nothing has exited
+	}
+	got := int(uint32(p[4]) | uint32(p[5])<<8 | uint32(p[6])<<16 | uint32(p[7])<<24)
+	if wstatus != nil {
+		switch st[0] {
+		case 1:
+			*wstatus = WaitStatus(uint32(st[2])|uint32(st[3])<<8) << 8
+		case 2:
+			*wstatus = WaitStatus(st[4] & 0x7f)
+		default:
+			*wstatus = 0
+		}
+	}
+	return got, nil
+}
+
+func Pipe(fd []int) error {
+	if len(fd) != 2 {
+		return EINVAL
+	}
+	var r, w uint32
+	if errno := fd_pipe(unsafe.Pointer(&r), unsafe.Pointer(&w)); errno != 0 {
+		return errno
+	}
+	fd[0], fd[1] = int(r), int(w)
+	return nil
+}
