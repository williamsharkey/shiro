     m->flags = SetFlag(m->flags, FLAGS_OF, false);
+    m->flags = SetFlag(m->flags, FLAGS_AF, false);
   } else {
     m->flags = SetFlag(m->flags, FLAGS_ZF, true);
     m->flags = SetFlag(m->flags, FLAGS_CF, true);
