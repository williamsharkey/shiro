From fe5955a3fbc289bc0e95fe3ec792c80e22c5681f Mon Sep 17 00:00:00 2001
From: shiro <build@shiro>
Date: Fri, 9 Oct 2026 00:14:26 +0000
Subject: [PATCH 25/25] emscripten: mlock/munlock/mlockall/munlockall succeed
 (wasm memory is never paged out)

---
 blink/syscall.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/blink/syscall.c b/blink/syscall.c
index b6e3481..da37b8b 100644
--- a/blink/syscall.c
+++ b/blink/syscall.c
@@ -5373,6 +5373,21 @@ static int SysSchedGetPriorityMin(struct Machine *m, int policy) {
   return 0;
 }
 
+#ifdef __EMSCRIPTEN__
+// WebAssembly memory is never paged out: locking it always succeeds (GnuPG
+// and ssh-agent lock their secret memory, and warn when they can't)
+static int SysMlock(struct Machine *m, i64 addr, u64 len) {
+  return 0;
+}
+static int SysMlockall(struct Machine *m, int flags) {
+  if (flags & ~7) return einval();
+  return 0;
+}
+static int SysMunlockall(struct Machine *m) {
+  return 0;
+}
+#endif
+
 static int SysPipe(struct Machine *m, i64 pipefds_addr) {
   return SysPipe2(m, pipefds_addr, 0);
 }
@@ -5806,6 +5821,12 @@ void OpSyscall(P) {
     SYSCALL(3, 0x077, "setresgid", SysSetresgid, STRACE_SETRESGID);
     SYSCALL(3, 0x078, "getresgid", SysGetresgid, STRACE_3);
     SYSCALL(5, 0x09D, "prctl", SysPrctl, STRACE_5);
+#ifdef __EMSCRIPTEN__
+    SYSCALL(2, 0x095, "mlock", SysMlock, STRACE_2);
+    SYSCALL(2, 0x096, "munlock", SysMlock, STRACE_2);
+    SYSCALL(1, 0x097, "mlockall", SysMlockall, STRACE_1);
+    SYSCALL(0, 0x098, "munlockall", SysMunlockall, STRACE_0);
+#endif
 #if !defined(DISABLE_OVERLAYS) || !defined(DISABLE_VFS)
     SYSCALL(1, 0x0A1, "chroot", SysChroot, STRACE_CHROOT);
 #endif
-- 
