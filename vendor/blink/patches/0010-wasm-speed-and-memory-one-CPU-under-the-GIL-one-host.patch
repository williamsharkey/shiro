diff --git a/blink/memorymalloc.c b/blink/memorymalloc.c
index 8329696..537b435 100644
--- a/blink/memorymalloc.c
+++ b/blink/memorymalloc.c
@@ -62,6 +62,56 @@ struct Allocator {
 struct Machine g_bssmachine;
 struct HostPages g_hostpages;
 
+#ifdef __EMSCRIPTEN__
+// Under emscripten every host mmap() of a file is a proxied call that
+// allocates, zeroes and copies a 64 KiB-aligned block, so mapping a file
+// one 4 KiB page at a time (how the software MMU normally does it) cost
+// seconds and hundreds of MB for a large binary. File mappings are made as
+// one host block instead; its pages are released one by one and the block
+// is unmapped with the last of them.
+struct MugBlock {
+  u8 *base;
+  size_t size;
+  long refs;
+  struct MugBlock *next;
+};
+static pthread_mutex_t_ g_mugblocks_lock = PTHREAD_MUTEX_INITIALIZER_;
+static struct MugBlock *g_mugblocks;
+
+static void AddMugBlock(u8 *base, size_t size, long pages) {
+  struct MugBlock *b;
+  unassert((b = (struct MugBlock *)malloc(sizeof(*b))));
+  b->base = base;
+  b->size = size;
+  b->refs = pages;
+  LOCK(&g_mugblocks_lock);
+  b->next = g_mugblocks;
+  g_mugblocks = b;
+  UNLOCK(&g_mugblocks_lock);
+}
+
+// Drops one page of a block; true if `page` belonged to one.
+static bool ReleaseMugPage(u8 *page) {
+  struct MugBlock *b, **p;
+  LOCK(&g_mugblocks_lock);
+  for (p = &g_mugblocks; (b = *p); p = &b->next) {
+    if (b->base <= page && page < b->base + b->size) {
+      if (!--b->refs) {
+        *p = b->next;
+        UNLOCK(&g_mugblocks_lock);
+        unassert(!Munmap(b->base, b->size));
+        free(b);
+        return true;
+      }
+      UNLOCK(&g_mugblocks_lock);
+      return true;
+    }
+  }
+  UNLOCK(&g_mugblocks_lock);
+  return false;
+}
+#endif
+
 static void FillPage(void *p, int c) {
   memset(p, c, 4096);
 }
