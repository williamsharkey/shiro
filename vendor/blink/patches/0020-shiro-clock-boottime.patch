From b7053464f7b4cf5875f3361f4b501d6d3eff6272 Mon Sep 17 00:00:00 2001
From: Shiro <shiro@localhost>
Date: Thu, 8 Oct 2026 22:56:28 +0000
Subject: [PATCH] emscripten: Shiro CLOCK_BOOTTIME comes from the kernel
 (uptime and process start times match /proc)

---
 blink/shiro.inc | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/blink/shiro.inc b/blink/shiro.inc
index ce437a7..7033d10 100644
--- a/blink/shiro.inc
+++ b/blink/shiro.inc
@@ -1287,6 +1287,16 @@ static bool ShiroSyscall(struct Machine *m, int nr, u64 a, u64 b, u64 c,
     }
   }
   switch (nr) {
+    case 0x0E4:                                                       // clock_gettime
+      // CLOCK_BOOTTIME counts from the kernel's boot (procps' uptime and
+      // process start times, like /proc); the other clocks stay local
+      if (a != 7) return false;
+      {
+        u8 ts[16];
+        r = ShiroCall(m, 228, A12(7), ts, 0, 16, false, false);
+        if (r >= 0 && b && CopyToUserWrite(m, b, ts, 16) == -1) r = -EFAULT_LINUX;
+      }
+      break;
     case 0x000: r = ShiroRead(m, a, b, c); break;
     case 0x001: r = ShiroWrite(m, a, b, c); break;
     case 0x011: r = ShiroPread(m, 17, a, b, c, d); break;
