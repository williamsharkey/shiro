+// Host pages that several processes in this instance map (MAP_SHARED
+// memory across a same-instance fork, shiro.inc): their PTEs carry
+// PAGE_GROW (unused otherwise) and the page is freed by its last unmapper.
+static pthread_mutex_t_ g_shared_lock = PTHREAD_MUTEX_INITIALIZER_;
+static struct {
+  u8 **page;
+  long *refs;
+  long n, c;
+} g_shared;
+
+void ShareHostPage(u8 *page) {
+  long i;
+  LOCK(&g_shared_lock);
+  for (i = 0; i < g_shared.n; ++i) {
+    if (g_shared.page[i] == page) {
+      ++g_shared.refs[i];
+      UNLOCK(&g_shared_lock);
+      return;
+    }
+  }
+  if (g_shared.n == g_shared.c) {
+    g_shared.c = g_shared.c ? g_shared.c * 2 : 64;
+    unassert((g_shared.page = (u8 **)realloc(g_shared.page, g_shared.c * sizeof(*g_shared.page))));
+    unassert((g_shared.refs = (long *)realloc(g_shared.refs, g_shared.c * sizeof(*g_shared.refs))));
+  }
+  g_shared.page[g_shared.n] = page;
+  g_shared.refs[g_shared.n++] = 1;
+  UNLOCK(&g_shared_lock);
+}
+
+// drops a reference; returns how many remain
+static long UnshareHostPage(u8 *page) {
+  long i, r = 0;
+  LOCK(&g_shared_lock);
+  for (i = 0; i < g_shared.n; ++i) {
+    if (g_shared.page[i] == page) {
+      if (!(r = --g_shared.refs[i])) {
+        g_shared.page[i] = g_shared.page[--g_shared.n];
+        g_shared.refs[i] = g_shared.refs[g_shared.n];
+      }
+      break;
+    }
+  }
+  UNLOCK(&g_shared_lock);
+  return r;
+}
+
 static void FillPage(void *p, int c) {
   memset(p, c, 4096);
 }
@@ -712,6 +759,11 @@ static bool FreePage(struct System *s, i64 virt, u64 entry, u64 size,
     }
 #endif
   }
+  if ((entry & PAGE_GROW) && UnshareHostPage(FindHostPage(entry)) > 0) {
+    s->memstat.committed -= 1;  // another process still maps it
+    --*rss_delta;
+    return false;
+  }
   if ((entry & (PAGE_HOST | PAGE_MAP | PAGE_MUG)) == PAGE_HOST) {
     unassert(~entry & PAGE_RSRV);
     s->memstat.committed -= 1;
