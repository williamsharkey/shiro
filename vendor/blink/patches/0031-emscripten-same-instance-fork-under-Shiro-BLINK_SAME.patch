+// ── same-instance fork (BLINK_SAME_INSTANCE_FORK) ────────────────────────
+//
+// The child is a new System with its own guest thread in this Blink
+// instance (the same wasm memory): private pages are copied, and the pages
+// of writable MAP_SHARED mappings are mapped by both (PAGE_GROW, refcounted
+// in memorymalloc.c), so the memory and its futexes really are shared and
+// parent and child run concurrently. Its kernel calls go out as its pid.
+
+static bool ShiroSameInstanceFork(void) {
+  static int on = -1;
+  const char *e;
+  if (on < 0) on = (e = getenv("BLINK_SAME_INSTANCE_FORK")) && *e && strcmp(e, "0");
+  return on;
+}
+
+bool ShiroIsInstanceChild(struct Machine *m) {
+  return g_shiro_pid && m->system->pid && m->system->pid != g_shiro_pid;
+}
+
+// The children this instance hosts, for signals the embedder routes by pid.
+static pthread_mutex_t_ g_shiro_kids_lock = PTHREAD_MUTEX_INITIALIZER_;
+static struct System *g_shiro_kids[256];
+static int g_shiro_nkids;
+static _Atomic(int) g_shiro_kids_starting;  // forked, thread not running yet
+void ShiroSignalSystem(struct System *, int);
+void ShiroDropSystem(void);
+extern void shiro_hosted(int pid);  // host.mjs: the page tracks it with us
+
+static void ShiroAddKid(struct System *s) {
+  LOCK(&g_shiro_kids_lock);
+  if (g_shiro_nkids < (int)ARRAYLEN(g_shiro_kids)) g_shiro_kids[g_shiro_nkids++] = s;
+  UNLOCK(&g_shiro_kids_lock);
+}
+
+static void ShiroDropKid(struct System *s) {
+  int i;
+  LOCK(&g_shiro_kids_lock);
+  for (i = 0; i < g_shiro_nkids; ++i) {
+    if (g_shiro_kids[i] == s) {
+      g_shiro_kids[i] = g_shiro_kids[--g_shiro_nkids];
+      break;
+    }
+  }
+  UNLOCK(&g_shiro_kids_lock);
+}
+
+// the kernel signalled hosted child `pid` (host.mjs routes by pid)
+EMSCRIPTEN_KEEPALIVE void blink_shiro_signal_pid(int pid, int sig) {
+  int i;
+  LOCK(&g_shiro_kids_lock);
+  for (i = 0; i < g_shiro_nkids; ++i) {
+    if (g_shiro_kids[i]->pid == pid) {
+      ShiroSignalSystem(g_shiro_kids[i], sig);
+      break;
+    }
+  }
+  UNLOCK(&g_shiro_kids_lock);
+}
+
+// exit_group of the instance's own process while hosted children run: the
+// kernel ends the process, this thread goes, and the worker stays until
+// the last child is done (the page keeps it)
+bool ShiroParentExitWithKids(struct Machine *m, int rc) {
+  int n;
+  LOCK(&g_shiro_kids_lock);
+  n = g_shiro_nkids + g_shiro_kids_starting;
+  UNLOCK(&g_shiro_kids_lock);
+  if (!n || ShiroIsInstanceChild(m)) return false;
+  KS(m, 231, A12(rc & 255));
+  ShiroDropSystem();
+  ClearChildTid(m);
+  FreeMachine(m);
+  GilRelease();
+  pthread_exit(0);
+}
+
+// Moves the pages of [virt, virt+size) onto host pages of their own, marked
+// shared, so a child can map the same ones.
+static void ShiroShareRange(struct System *s, i64 virt, i64 size) {
+  i64 v;
+  u64 e, n;
+  u8 *slot, *np;
+  for (v = virt & -4096; v < virt + size; v += 4096) {
+    if (!(slot = ShiroPteSlot(s, v))) continue;
+    e = LoadPte(slot);
+    if (!(e & PAGE_V) || (e & PAGE_GROW) || !(e & PAGE_U)) continue;
+    if ((n = AllocateAnonymousPage(s)) == (u64)-1) continue;
+    np = FindHostPage(n);
+    if (e & PAGE_RSRV) {
+      memset(np, 0, 4096);
+      s->memstat.reserved -= 1;
+      s->memstat.committed += 1;
+    } else {
+      memcpy(np, GetPageAddress(s, e, false), 4096);
+      if ((e & (PAGE_HOST | PAGE_MAP | PAGE_MUG)) == PAGE_HOST) {
+        u8 *old = FindHostPage(e);
+        memset(old, 0, 4096);
+        FreeAnonymousPage(s, old);
+        s->rss -= 1;
+      }  // (pages of a host block or mug stay with their block)
+    }
+    StorePte(slot, (n & (PAGE_TA | PAGE_HOST)) | (e & (PAGE_U | PAGE_RW | PAGE_XD)) |
+                       PAGE_V | PAGE_GROW);
+    ShareHostPage(np);
+  }
+}
