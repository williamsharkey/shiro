From 5d0092f448635c7b570656c82a963faf61d003b7 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 03:49:26 +0000
Subject: [PATCH] Shiro: rt_sigqueueinfo carries its siginfo to the kernel;
 sched_* take a thread's tid

Conformance (Open POSIX sigqueue, sigwaitinfo, pthread_*):
- rt_sigqueueinfo and rt_tgsigqueueinfo pass the guest's struct siginfo
  to the kernel (syscalls 129 and 297, unix/conformance), which queues
  real-time signals once per call with their si_code, si_value and sender
  and hands them out in order (rt_sigtimedwait's siginfo, and
  SYS_shiro_siginfo 1030 for a handler's). A kernel without them gets
  kill(2), as 0084 did.
- sched_{get,set}param and sched_{get,set}scheduler (0089) answered a
  thread's tid as another process (ESRCH, EPERM): glibc applies a new
  thread's explicit scheduling attributes that way, so pthread_create with
  them failed. One of this process's threads now counts as itself.
Exports blink_shiro_siginfo.
---
 blink/shiro.inc | 34 ++++++++++++++++++++++++++--------
 1 file changed, 26 insertions(+), 8 deletions(-)

diff --git a/blink/shiro.inc b/blink/shiro.inc
index 4a49e9a..c465264 100644
--- a/blink/shiro.inc
+++ b/blink/shiro.inc
@@ -2236,6 +2236,8 @@ EMSCRIPTEN_KEEPALIVE int blink_shiro_sigqueue(void) { return 1; }
 EMSCRIPTEN_KEEPALIVE int blink_shiro_mqueue(void) { return 1; }
 // 0087: POSIX timers are the kernel's; sched_* answers as Linux's
 EMSCRIPTEN_KEEPALIVE int blink_shiro_timers(void) { return 1; }
+// 0092: rt_sigqueueinfo carries its siginfo to the kernel
+EMSCRIPTEN_KEEPALIVE int blink_shiro_siginfo(void) { return 1; }
 
 // the kernel signalled hosted child `pid` (host.mjs routes by pid)
 EMSCRIPTEN_KEEPALIVE void blink_shiro_signal_pid(int pid, int sig) {
@@ -2854,6 +2856,18 @@ static i64 ShiroMsgctl(struct Machine *m, int id, int cmd, i64 buf) {
 
 // ── the dispatcher ───────────────────────────────────────────────────────
 
+// Is `tid` one of this process's threads? (sched_* take a thread's tid)
+static bool ShiroIsOwnThread(struct Machine *m, int tid) {
+  struct Dll *e;
+  bool found = false;
+  LOCK(&m->system->machines_lock);
+  for (e = dll_first(m->system->machines); e && !found; e = dll_next(m->system->machines, e)) {
+    found = MACHINE_CONTAINER(e)->tid == tid;
+  }
+  UNLOCK(&m->system->machines_lock);
+  return found;
+}
+
 static bool ShiroSyscall(struct Machine *m, int nr, u64 a, u64 b, u64 c,
                          u64 d, u64 e, u64 f, i64 *res) {
   i64 r;
@@ -2970,18 +2984,22 @@ static bool ShiroSyscall(struct Machine *m, int nr, u64 a, u64 b, u64 c,
       break;
     }
     case 0x081: case 0x129: {                                         // rt_sigqueueinfo, rt_tgsigqueueinfo
-      // The kernel delivers it as kill(2) does (signal 0 checks the target
-      // exists): glibc's sigqueue, and POSIX AIO's completion notice (an
-      // all-zero sigevent is SIGEV_SIGNAL with signal 0), work; the queued
-      // si_value doesn't reach the handler (signals carry no siginfo yet)
+      // The kernel queues it with its siginfo (si_code, si_value, the
+      // sender), real-time signals once per call: sigqueue, POSIX AIO's
+      // completion notice (glibc queues signal 0 for an all-zero sigevent).
+      // A kernel without rt_sigqueueinfo delivers it as kill(2).
       u8 si[128];
       int pid = (int)a, sig = nr == 0x081 ? (int)b : (int)c;
       i64 info = nr == 0x081 ? (i64)c : (i64)d;
       if (sig < 0 || sig > 64) { r = -EINVAL_LINUX; break; }
       if (CopyFromUserRead(m, si, info, sizeof(si)) == -1) { r = -EFAULT_LINUX; break; }
-      // only the kernel may claim SI_USER or a kernel si_code for another process (Linux)
-      if ((i32)Read32(si + 8) >= 0 && pid != m->system->pid) { r = -EPERM_LINUX; break; }
-      r = KS(m, 62, A12(pid, sig));                                   // kill
+      r = nr == 0x081 ? ShiroCall(m, 129, A12(pid, sig), si, sizeof(si), 0, false, false)
+                      : ShiroCall(m, 297, A12(pid, (int)b, sig), si, sizeof(si), 0, false, false);
+      if (r == -ENOSYS_LINUX) {
+        // only the kernel may claim SI_USER or a kernel si_code for another process (Linux)
+        if ((i32)Read32(si + 8) >= 0 && pid != m->system->pid) { r = -EPERM_LINUX; break; }
+        r = KS(m, 62, A12(pid, sig));                                 // kill
+      }
       break;
     }
     case 0x0C8: case 0x0EA: {                                         // tkill, tgkill
@@ -3054,7 +3072,7 @@ static bool ShiroSyscall(struct Machine *m, int nr, u64 a, u64 b, u64 c,
       int pid = (int)a, self, policy, prio = 0;
       u8 p[4];
       if (pid < 0) { r = -EINVAL_LINUX; break; }
-      self = !pid || pid == m->system->pid;
+      self = !pid || pid == m->system->pid || ShiroIsOwnThread(m, pid);  // (glibc passes a thread's tid)
       if (!self && (r = KS(m, 62, A12(pid, 0))) == -ESRCH_LINUX) break;  // kill(pid, 0): does it exist?
       if (nr == 0x091) { r = self ? m->system->sched_policy : 0; break; }
       if (nr == 0x08F) {
-- 
