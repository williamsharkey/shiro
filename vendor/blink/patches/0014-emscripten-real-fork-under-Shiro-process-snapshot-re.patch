+bool ShiroIsRestore(void);
+void ShiroRestore(struct Machine *);
 
 // Called by the embedder (Shiro's worker host) when the kernel signals this
 // process: queue `sig` (Linux numbering) on a guest thread that doesn't
@@ -271,6 +273,14 @@ static int Exec(char *execfn, char *prog, char **argv, char **envp) {
 #endif
   if (!old) {
     // this is the first time a program is being loaded
+#ifdef __EMSCRIPTEN__
