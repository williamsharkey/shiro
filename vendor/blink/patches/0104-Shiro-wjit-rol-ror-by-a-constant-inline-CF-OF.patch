From 033eb632e5e28f54982e5528652304598962be59 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 05:53:53 +0000
Subject: [PATCH 104/109] Shiro wjit: rol/ror by a constant inline (CF, OF)

---
 blink/wjit.c | 94 ++++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 92 insertions(+), 2 deletions(-)

diff --git a/blink/wjit.c b/blink/wjit.c
index 766023c..30a27f2 100644
--- a/blink/wjit.c
+++ b/blink/wjit.c
@@ -229,6 +229,10 @@ enum {
   W_I64_SHL = 0x86,
   W_I64_SHR_S = 0x87,
   W_I64_SHR_U = 0x88,
+  W_I64_ROTL = 0x89,
+  W_I64_ROTR = 0x8a,
+  W_I32_ROTL = 0x77,
+  W_I32_ROTR = 0x78,
   W_I32_WRAP_I64 = 0xa7,
   W_I64_EXTEND_I32_S = 0xac,
   W_I64_EXTEND_I32_U = 0xad,
@@ -1569,7 +1573,15 @@ static void Analyze(struct Ins *in) {
     case 0x0D0:
     case 0x0D1:
     case 0x0D3:
-      if (ShiftKind(ModrmReg(rde)) < 0) goto Call;
+      if (ShiftKind(ModrmReg(rde)) < 0) {
+        // rol/ror by a constant (SHA-1's rounds, hashes): CF and OF only
+        if (ModrmReg(rde) > 1 || op == 0x0D3 || ((op & 1) && w == 2)) goto Call;
+        in->fw = (op == 0x0D0 || op == 0x0D1 ||
+                  (in->uimm0 & ((op & 1) && w == 8 ? 63 : 31)))
+                     ? CF | OF
+                     : 0;
+        return;
+      }
       if ((op & 1) && w == 2) goto Call;
       in->fw = kAllFlags;  // conditionally, when the count is nonzero
       in->fr = op == 0x0D3 ? kAllFlags : 0;
@@ -2125,6 +2137,80 @@ static void TranslateShift(struct Cg *g, struct Ins *in) {
   PutRm(g, in, w, true);
 }
 
+// rol/ror by a constant, as alu.c's Rol/Ror: CF is the bit rotated into
+// the low (rol) or high (ror) end, OF the top bit xor CF (rol) or the top
+// two bits xored (ror); a masked count of 0 changes nothing
+static void TranslateRotate(struct Cg *g, struct Ins *in) {
+  u64 rde = in->rde;
+  int op = Mopcode(rde);
+  int w = (op & 1) ? Width(rde) : 1, bits = w * 8;
+  bool rol = !ModrmReg(rde);
+  int c = (op == 0x0D0 || op == 0x0D1) ? 1 : (int)(in->uimm0 & (w == 8 ? 63 : 31));
+  int r = c % bits;
+  GetRmForUpdate(g, in, w);
+  Set(g, L_CX);
+  if (!c) {
+    Get(g, L_CX);
+    PutRm(g, in, w, true);
+    return;
+  }
+  Get(g, L_CX);
+  if (!r) {
+    // (an 8-bit rotate by 8, 16 or 24: the value stays, the flags change)
+  } else if (w == 8) {
+    I64(g, r);
+    Op(g, rol ? W_I64_ROTL : W_I64_ROTR);
+  } else if (w == 4) {
+    Op(g, W_I32_WRAP_I64);
+    I32(g, r);
+    Op(g, rol ? W_I32_ROTL : W_I32_ROTR);
+    Op(g, W_I64_EXTEND_I32_U);
+  } else {
+    I64(g, rol ? r : bits - r);
+    Op(g, W_I64_SHL);
+    Get(g, L_CX);
+    I64(g, rol ? bits - r : r);
+    Op(g, W_I64_SHR_U);
+    Op(g, W_I64_OR);
+    I64(g, Mask(w));
+    Op(g, W_I64_AND);
+  }
+  Set(g, L_CZ);
+  if (in->live & (CF | OF)) {
+    g->flags = true;
+    Get(g, L_F);
+    I32(g, ~(CF | OF));
+    Op(g, W_I32_AND);
+    // cf
+    Get(g, L_CZ);
+    if (!rol) {
+      I64(g, bits - 1);
+      Op(g, W_I64_SHR_U);
+    }
+    Op(g, W_I32_WRAP_I64);
+    I32(g, 1);
+    Op(g, W_I32_AND);
+    Op(g, W_I32_OR);
+    // of: bit bits-1 of z ^ (rol ? z << (bits-1) : z << 1)
+    Get(g, L_CZ);
+    Get(g, L_CZ);
+    I64(g, rol ? bits - 1 : 1);
+    Op(g, W_I64_SHL);
+    Op(g, W_I64_XOR);
+    I64(g, bits - 1);
+    Op(g, W_I64_SHR_U);
+    Op(g, W_I32_WRAP_I64);
+    I32(g, 1);
+    Op(g, W_I32_AND);
+    I32(g, FLAGS_OF);
+    Op(g, W_I32_SHL);
+    Op(g, W_I32_OR);
+    Set(g, L_F);
+  }
+  Get(g, L_CZ);
+  PutRm(g, in, w, true);
+}
+
 static void TranslateImul(struct Cg *g, struct Ins *in) {
   u64 rde = in->rde;
   int op = Mopcode(rde);
@@ -2876,7 +2962,11 @@ static void Translate(struct Cg *g, struct Ins *in) {
     case 0x0D0:
     case 0x0D1:
     case 0x0D3:
-      TranslateShift(g, in);
+      if (ShiftKind(ModrmReg(rde)) < 0) {
+        TranslateRotate(g, in);
+      } else {
+        TranslateShift(g, in);
+      }
       return;
     case 0x088:  // mov Eb,Gb
     case 0x089:  // mov Ev,Gv
-- 
2.43.0

