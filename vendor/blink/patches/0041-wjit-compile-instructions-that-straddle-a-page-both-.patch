From 1dff43124302bcf7a48131f71329035d548979d5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 9 Oct 2026 09:23:17 +0000
Subject: [PATCH 41/41] wjit: compile instructions that straddle a page (both
 pages read-only code); rep movs/stos of words, dwords and qwords a page at a
 time

---
 blink/string.c | 69 ++++++++++++++++++++++++++++++++++++++++++++++++++
 blink/wjit.c   | 37 ++++++++++++++++++++-------
 2 files changed, 97 insertions(+), 9 deletions(-)

diff --git a/blink/string.c b/blink/string.c
index 54eea75..906a6ab 100644
--- a/blink/string.c
+++ b/blink/string.c
@@ -289,7 +289,75 @@ static void RepStosbEnhanced(P) {
   }
 }
 
+// rep movs/stos of words, dwords and qwords going up (musl's memcpy and
+// memset): a page at a time like the byte forms above. Elements that
+// straddle a page, and the rest after one, take the general path.
+static bool RepMovsFast(P, unsigned n) {
+  u8 *direal, *sireal;
+  u64 diactual, siactual, cx;
+  long diremain, siremain, k, i;
+  if (GetFlag(m->flags, FLAGS_DF)) return false;
+  if (!(cx = ReadCx(A))) return true;
+  diactual = AddressDi(A);
+  siactual = AddressSi(A);
+  SetWriteAddr(m, diactual, cx * n);
+  SetReadAddr(m, siactual, cx * n);
+  IGNORE_RACES_START();
+  atomic_thread_fence(memory_order_acquire);
+  do {
+    diremain = MIN(4096 - (diactual & 4095), 65536 - Get16(m->di));
+    siremain = MIN(4096 - (siactual & 4095), 65536 - Get16(m->si));
+    k = MIN((long)cx, MIN(diremain, siremain) / (long)n);
+    if (!k) break;
+    direal = ResolveAddress(m, diactual);
+    sireal = ResolveAddress(m, siactual);
+    if (!IsRomAddress(m, direal)) {
+      if (direal >= sireal + k * n || sireal >= direal + k * n ||
+          direal <= sireal) {
+        memmove(direal, sireal, k * n);  // as element by element would
+      } else {
+        for (i = 0; i < k; ++i) memmove(direal + i * n, sireal + i * n, n);
+      }
+    }
+    AddDi(A, k * n);
+    AddSi(A, k * n);
+    if ((cx = SubtractCx(A, k))) {
+      diactual = AddressDi(A);
+      siactual = AddressSi(A);
+    }
+  } while (cx);
+  atomic_thread_fence(memory_order_release);
+  IGNORE_RACES_END();
+  return !cx;
+}
+
+static bool RepStosFast(P, unsigned n) {
+  u8 *direal;
+  u64 diactual, cx;
+  long diremain, k, i;
+  if (GetFlag(m->flags, FLAGS_DF)) return false;
+  if (!(cx = ReadCx(A))) return true;
+  diactual = AddressDi(A);
+  SetWriteAddr(m, diactual, cx * n);
+  IGNORE_RACES_START();
+  do {
+    diremain = MIN(4096 - (diactual & 4095), 65536 - Get16(m->di));
+    k = MIN((long)cx, diremain / (long)n);
+    if (!k) break;
+    direal = ResolveAddress(m, diactual);
+    if (!IsRomAddress(m, direal)) {
+      for (i = 0; i < k; ++i) memcpy(direal + i * n, m->ax, n);
+    }
+    AddDi(A, k * n);
+    if ((cx = SubtractCx(A, k))) diactual = AddressDi(A);
+  } while (cx);
+  atomic_thread_fence(memory_order_release);
+  IGNORE_RACES_END();
+  return !cx;
+}
+
 void OpMovs(P) {
+  if (Rep(rde) && RepMovsFast(A, 1 << RegLog2(rde))) return;
   StringOp(A, STRING_MOVS);
 }
 
@@ -298,6 +366,7 @@ void OpCmps(P) {
 }
 
 void OpStos(P) {
+  if (Rep(rde) && RepStosFast(A, 1 << RegLog2(rde))) return;
   StringOp(A, STRING_STOS);
 }
 
diff --git a/blink/wjit.c b/blink/wjit.c
index 90a91db..ba3b880 100644
--- a/blink/wjit.c
+++ b/blink/wjit.c
@@ -3046,21 +3046,30 @@ static void Translate(struct Cg *g, struct Ins *in) {
 // block discovery, module assembly, cache
 
 // decodes the basic block at `pc` into g->in; false if it's empty
-static bool DecodeBlock(struct Cg *g, i64 pc) {
-  int len;
+// the host address of the code page at `page` if it can't change under
+// compiled code (user, read-only, executable), else 0
+static u8 *CodePage(struct Machine *m, i64 page) {
   u64 entry;
   u8 *host;
+  if (!(entry = FindPageTableEntry(m, page))) return 0;
+  if ((entry & (PAGE_U | PAGE_RW | PAGE_XD)) != PAGE_U) return 0;
+  if (!(host = GetPageAddress(m->system, entry, false))) return 0;
+  if (IsRomAddress(m, host)) return 0;
+  return host;
+}
+
+static bool DecodeBlock(struct Cg *g, i64 pc) {
+  int len;
+  u8 *host, *next, buf[15];
+  const u8 *p;
   struct XedDecodedInst x;
   struct Machine *m = g->m;
   struct Ins *in;
   struct Blk *b;
   i64 page = pc & -4096;
   if (g->nblk >= g_wj_maxblk || g->n > kMaxIns - kMaxIns / 8) return false;
-  if (!(entry = FindPageTableEntry(m, page))) return false;
   // only code that can't change under us
-  if ((entry & (PAGE_U | PAGE_RW | PAGE_XD)) != PAGE_U) return false;
-  if (!(host = GetPageAddress(m->system, entry, false))) return false;
-  if (IsRomAddress(m, host)) return false;
+  if (!(host = CodePage(m, page))) return false;
   b = &g->blk[g->nblk];
   b->start = pc;
   b->first = g->n;
@@ -3068,11 +3077,21 @@ static bool DecodeBlock(struct Cg *g, i64 pc) {
   while (b->n < 48 && g->n < kMaxIns) {
     if ((pc & -4096) != page) break;
     len = 4096 - (pc & 4095);
-    if (DecodeInstruction(&x, host + (pc & 4095), len < 15 ? len : 15,
-                          m->mode.omode)) {
+    p = host + (pc & 4095);
+    if (len < 15) {
+      // an instruction may continue on the next page: fine when that page
+      // can't change either (a change to either drops all compiled code),
+      // else the interpreter runs it (it would end the region every time)
+      if ((next = CodePage(m, page + 4096))) {
+        memcpy(buf, p, len);
+        memcpy(buf + len, next, 15 - len);
+        p = buf;
+        len = 15;
+      }
+    }
+    if (DecodeInstruction(&x, p, len < 15 ? len : 15, m->mode.omode)) {
       break;
     }
-    if ((pc & 4095) + x.length > 4096) break;
     if (ClassifyOp(x.op.rde) == kOpPrecious) break;
     in = &g->in[g->n++];
     ++b->n;
-- 
