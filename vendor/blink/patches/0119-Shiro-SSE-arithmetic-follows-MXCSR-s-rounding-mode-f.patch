From 368dbfb1d2f3fe67791ea93490fa6e80218e3d04 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 13:08:39 +0000
Subject: [PATCH] Shiro: SSE arithmetic follows MXCSR's rounding mode
 (fesetround)

The host (wasm) rounds to nearest only, so under FE_UPWARD, FE_DOWNWARD or
FE_TOWARDZERO every SSE add, subtract, multiply, divide and square root
(ss, sd, ps, pd) and cvtsd2ss/cvtpd2ps gave the nearest result. CGAL checks
this at startup ("Wrong rounding: did you forget -frounding-math?") and
aborted: OpenSCAD, and anything else using its interval arithmetic.

With MXCSR.RC not nearest, the nearest result is corrected by one step when
its exact error (TwoSum for add and subtract, an fma remainder for the rest,
taken on operands scaled by 2^200 when the result is tiny) says the true
value lies on the other side; floats are computed in double. Overflow gives
the largest finite value where the mode rounds toward zero, and an exact
zero sum is -0 rounding down. Compiled code rounds to nearest, so it doesn't
run while the mode is directed: ldmxcsr and fxrstor raise attention to
leave it, and WjExecute declines. Round to nearest costs one test per op.
x87 is unchanged (its long double is a double here).
---
 blink/cvt.c      |  11 ++-
 blink/fpu.h      |   2 +
 blink/machine.c  |   8 ++
 blink/ssefloat.c | 227 ++++++++++++++++++++++++++++++++++++++++++++++-
 blink/wjit.c     |   3 +
 5 files changed, 244 insertions(+), 7 deletions(-)

diff --git a/blink/cvt.c b/blink/cvt.c
index 759f77c..f30330a 100644
--- a/blink/cvt.c
+++ b/blink/cvt.c
@@ -277,8 +277,13 @@ static void OpVpsWpdCvtpd2ps(P) {
   p = GetModrmRegisterXmmPointerRead16(A);
   d[0].i = Read64(p + 0);
   d[1].i = Read64(p + 8);
-  f[0].f = d[0].f;
-  f[1].f = d[1].f;
+  if ((m->mxcsr & kMxcsrRc)) {  // directed rounding (ssefloat.c)
+    f[0].f = SseRoundToFloat(d[0].f, 0, (m->mxcsr & kMxcsrRc) >> 13);
+    f[1].f = SseRoundToFloat(d[1].f, 0, (m->mxcsr & kMxcsrRc) >> 13);
+  } else {
+    f[0].f = d[0].f;
+    f[1].f = d[1].f;
+  }
   Put32(XmmRexrReg(m, rde) + 0, f[0].i);
   Put32(XmmRexrReg(m, rde) + 4, f[1].i);
 }
@@ -287,7 +292,7 @@ static void OpVssWsdCvtsd2ss(P) {
   union FloatPun f;
   union DoublePun d;
   d.i = Read64(GetModrmRegisterXmmPointerRead8(A));
-  f.f = d.f;
+  f.f = (m->mxcsr & kMxcsrRc) ? SseRoundToFloat(d.f, 0, (m->mxcsr & kMxcsrRc) >> 13) : d.f;
   Put32(XmmRexrReg(m, rde), f.i);
 }
 
diff --git a/blink/fpu.h b/blink/fpu.h
