--- a/blink/fpu.h
+++ b/blink/fpu.h
@@ -45,6 +45,8 @@
 #define kMxcsrUm  0x0800 /* underflow mask */
 #define kMxcsrPm  0x1000 /* precision mask */
 #define kMxcsrRc  0x6000 /* rounding control */
+
+float SseRoundToFloat(double, int, int);  // ssefloat.c: directed rounding
 #define kMxcsrFtz 0x8000 /* flush to zero */
 
 #define FpuSt(m, i) ((m)->fpu.st + (((i) + ((m->fpu.sw & kFpuSwSp) >> 11)) & 7))
diff --git a/blink/machine.c b/blink/machine.c
index 049d032..0764fb1 100644
--- a/blink/machine.c
+++ b/blink/machine.c
@@ -1285,6 +1285,12 @@ static void OpFxsave(P) {
   SetWriteAddr(m, v, 416);
 }
 
+// compiled code rounds to nearest only (wjit.c): a directed rounding mode
+// makes it leave after this instruction, and not come back while it lasts
+static void NoteMxcsr(struct Machine *m) {
+  if (m->mxcsr & kMxcsrRc) atomic_store_explicit(&m->attention, true, memory_order_release);
+}
+
 static void OpFxrstor(P) {
   i64 v;
   u8 buf[32];
@@ -1303,6 +1309,7 @@ static void OpFxrstor(P) {
   m->fpu.ip = Load32(buf + 8);
 #endif
   m->mxcsr = Load32(buf + 24);
+  NoteMxcsr(m);
 }
 
 static void OpXsave(P) {
@@ -1310,6 +1317,7 @@ static void OpXsave(P) {
 
 static void OpLdmxcsr(P) {
   m->mxcsr = Load32(ComputeReserveAddressRead4(A));
+  NoteMxcsr(m);
 }
 
 static void OpStmxcsr(P) {
