   struct WjEnt *e;
   if (!g_wj_enabled) return 0;
   if (m->nrlocks) ShiroRemoteEnd(m);  // (a shared object's lease runs out)
+  // compiled code rounds to nearest: a directed rounding mode (MXCSR.RC,
