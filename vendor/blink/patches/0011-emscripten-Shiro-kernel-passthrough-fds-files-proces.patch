+    case 0x146: r = -ENOSYS_LINUX; break;                             // copy_file_range
+    case 0x13F: r = -ENOSYS_LINUX; break;                             // memfd_create
+    case 0x085: case 0x103: r = -EPERM_LINUX; break;                  // mknod(at)
+    case 0x0FD: case 0x0FE: case 0x0FF: case 0x126: r = -ENOSYS_LINUX; break;  // inotify
+    case 0x11B: case 0x11D: case 0x11E: case 0x11F: r = -ENOSYS_LINUX; break;  // timerfd, fallocate...
+    case 0x1B2: case 0x1A8: r = -ENOSYS_LINUX; break;                 // pidfd_open, pidfd_send_signal
+    case 0x03D: r = ShiroWait4(m, a, b, c, d); break;                 // wait4
+    case 0x0F7: r = ShiroWaitid(m, a, b, c, d, e); break;             // waitid
+    case 0x03E: r = KS(m, 62, A12(a, b)); break;                      // kill
+    case 0x06E: r = KS(m, 110, A12(0)); break;                        // getppid
+    case 0x06F: r = KS(m, 111, A12(0)); break;                        // getpgrp
+    case 0x079: r = KS(m, 121, A12(a)); break;                        // getpgid
+    case 0x07C: r = KS(m, 124, A12(a)); break;                        // getsid
+    case 0x06D: r = KS(m, 109, A12(a, b)); break;                     // setpgid
+    case 0x070: r = KS(m, 112, A12(0)); break;                        // setsid
+    case 0x066: case 0x06B: r = KS(m, 102, A12(0)); break;            // getuid, geteuid
+    case 0x068: case 0x06C: r = KS(m, 104, A12(0)); break;            // getgid, getegid
+    case 0x076: case 0x078: {                                         // getresuid/gid
+      u8 id[4];
+      i64 v = KS(m, nr == 0x076 ? 102 : 104, A12(0));
+      Write32(id, v);
+      r = 0;
+      if ((a && CopyToUserWrite(m, a, id, 4) == -1) || (b && CopyToUserWrite(m, b, id, 4) == -1) ||
+          (c && CopyToUserWrite(m, c, id, 4) == -1)) r = -EFAULT_LINUX;
+      break;
+    }
+    case 0x069: case 0x06A: case 0x071: case 0x072: case 0x075: case 0x077:
+    case 0x074: case 0x07A: case 0x07B:                               // set*id, setgroups, setfs*id
+      r = 0;
+      break;
+    case 0x039: r = ShiroVfork(m, 0, true); break;                    // fork
+    case 0x03A: r = ShiroVfork(m, 0, false); break;                   // vfork
+    case 0x038:                                                       // clone
+      if (!IsForkOrVfork(a)) return false;                           // threads stay Blink's
+      r = ShiroVfork(m, b, !(a & CLONE_VFORK_LINUX));
+      break;
+    case 0x03B: r = ShiroExecve(m, a, b, c); break;                   // execve
+    case 0x00D: {                                                     // rt_sigaction
+      r = SysSigaction(m, a, b, c, d);
+      r = r == -1 ? ShiroErr() : r;
+      if (r == 0 && b && a >= 1 && a <= 64) {
+        LOCK(&m->system->sig_lock);
+        u64 h = Read64(m->system->hands[a - 1].handler);
+        UNLOCK(&m->system->sig_lock);
+        ShiroMirrorSigaction(m, a, h);
+      }
+      break;
+    }
+    case 0x009:                                                       // mmap
+      if ((d & 0x20) || (i64)e < 0) return false;
+      BEGIN_NO_PAGE_FAULTS;
+      LOCK(&m->system->mmap_lock);
+      r = ShiroMmapFile(m, a, b, c, d, e, f);
+      UNLOCK(&m->system->mmap_lock);
+      END_NO_PAGE_FAULTS;
+      break;
+    case 0x00B:                                                       // munmap
+      if (g_shiro_maps) ShiroSyncMaps(m, a, b, true);
+      return false;
+    case 0x01A:                                                       // msync
+      if (g_shiro_maps) ShiroSyncMaps(m, a, b, false);
+      r = 0;
+      break;
+    default:
+      return false;
+  }
+  *res = r;
+  return true;
+}
