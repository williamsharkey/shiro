+      case 0x03C:  // exit
+      case 0x0E7:  // exit_group
+        KS(m, 231, A12((int)a & 255));
+        *res = ShiroVforkReturn(m);
+        return true;
+      default:
+        break;
+    }
+  }
+  switch (nr) {
+    case 0x000: r = ShiroRead(m, a, b, c); break;
+    case 0x001: r = ShiroWrite(m, a, b, c); break;
+    case 0x011: r = ShiroPread(m, 17, a, b, c, d); break;
+    case 0x012: r = ShiroPread(m, 18, a, b, c, d); break;
+    case 0x013: r = ShiroIov(m, false, a, b, c, -1); break;
+    case 0x014: r = ShiroIov(m, true, a, b, c, -1); break;
+    case 0x127: r = ShiroIov(m, false, a, b, c, d); break;           // preadv
+    case 0x128: r = ShiroIov(m, true, a, b, c, d); break;            // pwritev
+    case 0x147: r = ShiroIov(m, false, a, b, c, (i64)d); break;      // preadv2
+    case 0x148: r = ShiroIov(m, true, a, b, c, (i64)d); break;       // pwritev2
+    case 0x002: r = ShiroAtCall(m, 257, -100, a, b, c); break;       // open
+    case 0x055: r = ShiroAtCall(m, 257, -100, a, 0101 | 01000, b); break;  // creat
+    case 0x101: r = ShiroAtCall(m, 257, ShiroDirfd(a), b, c, d); break;    // openat
+    case 0x003: r = KS(m, 3, A12(a)); break;                          // close
+    case 0x1B4: r = KS(m, 436, A12(a, b, c)); break;                  // close_range
+    case 0x004: r = ShiroStatAt(m, -100, a, b, 0, 0); break;          // stat
+    case 0x006: r = ShiroStatAt(m, -100, a, b, 0x100, 0); break;      // lstat
+    case 0x005: r = ShiroStatAt(m, a, 0, b, 0x1000, 0); break;        // fstat
+    case 0x106:                                                       // newfstatat
+      if (b && !(d & 0x1000)) {
+        char *s = LoadStr(m, b);
+        if (s && !*s) { r = -ENOENT_LINUX; break; }
+      }
+      r = ShiroStatAt(m, a, b, c, d & (0x100 | 0x1000), 0);
+      break;
+    case 0x14C: r = ShiroStatx(m, a, b, c, e); break;                // statx
+    case 0x089: case 0x08A: r = ShiroStatfs(m, b); break;            // statfs, fstatfs
+    case 0x015: r = ShiroPathCall(m, 21, a, b, 0, 0); break;          // access
+    case 0x10D: case 0x1B7: r = ShiroAtCall(m, 269, a, b, c, 0); break;  // faccessat(2)
+    case 0x007: r = ShiroPoll(m, a, b, (int)c); break;
+    case 0x10F: {                                                     // ppoll
+      int ms;
+      if ((r = ShiroTimeoutMs(m, c, true, &ms)) < 0) break;
+      r = ShiroPoll(m, a, b, ms);
+      break;
+    }
+    case 0x017: r = ShiroSelect(m, a, b, c, d, e, false); break;
+    case 0x10E: r = ShiroSelect(m, a, b, c, d, e, true); break;      // pselect6
+    case 0x008: r = KS(m, 8, A12(a, (int)b, (int)((i64)b >> 32), c)); break;  // lseek
+    case 0x010: r = ShiroIoctl(m, a, b, c); break;
+    case 0x048: r = ShiroFcntl(m, a, b, c); break;
+    case 0x049: r = KS(m, 72, A12(a, 1, 0)) < 0 ? -EBADF_LINUX : 0; break;  // flock
+    case 0x04A: case 0x04B: r = KS(m, 74, A12(a)); break;            // fsync, fdatasync
+    case 0x0A2: case 0x132: r = 0; break;                            // sync, syncfs
+    case 0x0DD: case 0x0BB: case 0x115: r = 0; break;                // fadvise, readahead, sync_file_range
+    case 0x04C: r = ShiroPathCall(m, 76, a, (int)b, (int)((i64)b >> 32), 0); break;  // truncate
+    case 0x04D: r = KS(m, 77, A12(a, (int)b, (int)((i64)b >> 32))); break;       // ftruncate
+    case 0x04F: {                                                     // getcwd
+      char *buf = (char *)ShiroAlloc(m, 4097);
+      r = ShiroCall(m, 79, A12(4096), buf, 0, 4096, false, false);
+      if (r > 0) {
+        if ((u64)r > b) { r = -ERANGE_LINUX; break; }
+        if (CopyToUserWrite(m, a, buf, r) == -1) r = -EFAULT_LINUX;
+      }
+      break;
+    }
+    case 0x050: r = ShiroPathCall(m, 80, a, 0, 0, 0); break;          // chdir
+    case 0x051: r = KS(m, 81, A12(a)); break;                         // fchdir
+    case 0x052: r = ShiroTwoPaths(m, 82, 0, a, 0, b, 0, false); break;   // rename
+    case 0x108: r = ShiroTwoPaths(m, 264, a, b, c, d, 0, true); break;   // renameat
+    case 0x13C: r = ShiroTwoPaths(m, 316, a, b, c, d, e, true); break;   // renameat2
+    case 0x053: r = ShiroPathCall(m, 83, a, b, 0, 0); break;          // mkdir
+    case 0x102: r = ShiroAtCall(m, 258, a, b, c, 0); break;           // mkdirat
+    case 0x054: r = ShiroPathCall(m, 84, a, 0, 0, 0); break;          // rmdir
+    case 0x057: r = ShiroPathCall(m, 87, a, 0, 0, 0); break;          // unlink
+    case 0x107: r = ShiroAtCall(m, 263, a, b, c, 0); break;           // unlinkat
+    case 0x056: r = ShiroTwoPaths(m, 86, 0, a, 0, b, 0, false); break;   // link
+    case 0x109: r = ShiroTwoPaths(m, 265, a, b, c, d, e, true); break;   // linkat
+    case 0x058: r = ShiroTwoPaths(m, 88, 0, a, 0, b, 0, false); break;   // symlink
+    case 0x10A: {                                                     // symlinkat
+      char *buf = (char *)ShiroAlloc(m, 8192);
+      int x = ShiroPath(m, a, buf, 0), y;
+      if (x < 0) { r = x; break; }
+      if ((y = ShiroPath(m, c, buf, x)) < 0) { r = y; break; }
+      r = ShiroCall(m, 266, A12(x, (int)b, y), buf, x + y, 0, true, true);
+      break;
+    }
+    case 0x059: r = ShiroReadlinkAt(m, -100, a, b, c); break;         // readlink
+    case 0x10B: r = ShiroReadlinkAt(m, a, b, c, d); break;            // readlinkat
+    case 0x05A: r = ShiroPathCall(m, 90, a, b, 0, 0); break;          // chmod
+    case 0x05B: r = KS(m, 91, A12(a, b)); break;                      // fchmod
+    case 0x10C: case 0x1C4: r = ShiroAtCall(m, 268, a, b, c, 0); break;  // fchmodat(2)
+    case 0x05C: case 0x05E: r = ShiroPathCall(m, 21, a, 0, 0, 0); break;  // chown, lchown
+    case 0x05D: r = KS(m, 72, A12(a, 1, 0)) < 0 ? -EBADF_LINUX : 0; break;  // fchown
+    case 0x104: r = 0; break;                                         // fchownat
+    case 0x05F: r = KS(m, 95, A12(a)); break;                         // umask
+    case 0x084: {                                                     // utime
+      u8 t[32];
+      i64 tv = 0;
+      if (b) {
+        u8 u[16];
+        if (CopyFromUserRead(m, u, b, 16) == -1) { r = -EFAULT_LINUX; break; }
+        memset(t, 0, 32);
+        Write64(t, Read64(u)), Write64(t + 16, Read64(u + 8));
+        tv = 1;
+      }
+      if (tv) {
+        char *buf = (char *)ShiroAlloc(m, 4096 + 32);
+        int n = ShiroPath(m, a, buf, 0);
+        if (n < 0) { r = n; break; }
+        memcpy(buf + n, t, 32);
+        r = ShiroCall(m, 280, A12(-100, n, 0, 1), buf, n + 32, 0, true, true);
+      } else {
+        r = ShiroUtimens(m, -100, a, 0, 0, 0);
+      }
+      break;
+    }
+    case 0x0EB: r = ShiroUtimens(m, -100, a, b, 0, 1); break;         // utimes
+    case 0x105: r = ShiroUtimens(m, a, b, c, 0, 1); break;            // futimesat
+    case 0x118: r = ShiroUtimens(m, a, b, c, d, 0); break;            // utimensat
+    case 0x0D9: {                                                     // getdents64
+      int n = MIN(c, (u64)g_shiro_chunk);
+      u8 *buf = (u8 *)ShiroAlloc(m, n);
+      r = ShiroCall(m, 217, A12(a, n), buf, 0, n, true, true);
+      if (r > 0 && CopyToUserWrite(m, b, buf, r) == -1) r = -EFAULT_LINUX;
+      break;
+    }
+    case 0x04E: r = -ENOSYS_LINUX; break;                             // getdents
+    case 0x016: case 0x125: {                                         // pipe, pipe2
+      u8 fds[8];
+      r = ShiroCall(m, 293, A12(nr == 0x016 ? 0 : (int)b), fds, 0, 8, false, false);
+      if (r >= 0 && CopyToUserWrite(m, a, fds, 8) == -1) r = -EFAULT_LINUX;
+      break;
+    }
+    case 0x020: r = KS(m, 32, A12(a)); break;                         // dup
+    case 0x021: r = KS(m, 33, A12(a, b)); break;                      // dup2
+    case 0x124: r = KS(m, 292, A12(a, b, c)); break;                  // dup3
+    case 0x11C: r = KS(m, 290, A12(a, 0)); break;                     // eventfd
+    case 0x122: r = KS(m, 290, A12(a, b)); break;                     // eventfd2
+    case 0x0D5: r = KS(m, 213, A12(a)); break;                        // epoll_create
+    case 0x123: r = KS(m, 291, A12(a)); break;                        // epoll_create1
+    case 0x0E9: {                                                     // epoll_ctl
+      u8 ev[12];
+      memset(ev, 0, sizeof(ev));
+      if (d && CopyFromUserRead(m, ev, d, 12) == -1) { r = -EFAULT_LINUX; break; }
+      r = KS(m, 233, A12(a, b, c, Read32(ev), Read32(ev + 4), Read32(ev + 8)));
+      break;
+    }
+    case 0x0E8: r = ShiroEpollWait(m, a, b, c, d); break;             // epoll_wait
+    case 0x119: r = ShiroEpollWait(m, a, b, c, d); break;             // epoll_pwait
+    case 0x1B9: {                                                     // epoll_pwait2
+      int ms;
+      if ((r = ShiroTimeoutMs(m, d, true, &ms)) < 0) break;
+      r = ShiroEpollWait(m, a, b, c, ms);
+      break;
+    }
+    case 0x029: r = KS(m, 41, A12(a, b, c)); break;                   // socket
+    case 0x035: {                                                     // socketpair
+      u8 sv[8];
+      r = ShiroCall(m, 53, A12(a, b, c), sv, 0, 8, false, false);
+      if (r >= 0 && CopyToUserWrite(m, d, sv, 8) == -1) r = -EFAULT_LINUX;
+      break;
+    }
+    case 0x02A: r = ShiroAddrCall(m, 42, a, b, c); break;             // connect
+    case 0x031: r = ShiroAddrCall(m, 49, a, b, c); break;             // bind
+    case 0x032: r = KS(m, 50, A12(a, b)); break;                      // listen
+    case 0x02B: r = ShiroAccept(m, a, b, c, 0); break;                // accept
+    case 0x120: r = ShiroAccept(m, a, b, c, d); break;                // accept4
+    case 0x033: r = ShiroSockName(m, 51, a, b, c); break;             // getsockname
+    case 0x034: r = ShiroSockName(m, 52, a, b, c); break;             // getpeername
+    case 0x02C: r = ShiroSendto(m, a, b, c, d, e, f); break;          // sendto
+    case 0x02D: r = ShiroRecvfrom(m, a, b, c, d, e, f); break;        // recvfrom
+    case 0x02E: r = ShiroMsg(m, true, a, b, c); break;                // sendmsg
+    case 0x02F: r = ShiroMsg(m, false, a, b, c); break;               // recvmsg
+    case 0x030: r = KS(m, 48, A12(a, b)); break;                      // shutdown
+    case 0x036: r = ShiroSetsockopt(m, a, b, c, d, e); break;
+    case 0x037: r = ShiroGetsockopt(m, a, b, c, d, e); break;
+    case 0x028: {                                                     // sendfile
+      u8 *buf;
+      i64 off = -1, done = 0, n;
+      u8 offb[8];
+      if (d) {
+        if (CopyFromUserRead(m, offb, c, 8) == -1) { r = -EFAULT_LINUX; break; }
+        off = Read64(offb);
+      }
+      buf = (u8 *)ShiroAlloc(m, g_shiro_chunk);
+      r = 0;
+      while ((u64)done < d) {
+        int want = MIN(d - done, (u64)g_shiro_chunk);
+        if (off >= 0) {
+          n = ShiroCall(m, 17, A12(b, want, (int)(off + done), (int)((off + done) >> 32)), buf, 0, want, true, true);
+        } else {
