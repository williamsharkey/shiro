From b67bf676d572f8f27d94b2660302ad3762cce061 Mon Sep 17 00:00:00 2001
From: Shiro <shiro@localhost>
Date: Thu, 8 Oct 2026 20:44:36 +0000
Subject: [PATCH 17/20] pextrw zero-extends into the whole destination register
 (Rust's miniz_oxide inflate under LTO)

---
 blink/ssefloat.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/blink/ssefloat.c b/blink/ssefloat.c
index cf239ff..a13ddda 100644
--- a/blink/ssefloat.c
+++ b/blink/ssefloat.c
@@ -122,7 +122,8 @@ void OpPextrwGdqpUdqIb(P) {
   u8 i;
   i = uimm0;
   i &= Osz(rde) ? 7 : 3;
-  Put16(RegRexrReg(m, rde), Get16(XmmRexbRm(m, rde) + i * 2));
+  // zero-extended into the whole register, like any 32-bit destination
+  Put64(RegRexrReg(m, rde), Get16(XmmRexbRm(m, rde) + i * 2));
 }
 
 void OpPinsrwVdqEwIb(P) {
