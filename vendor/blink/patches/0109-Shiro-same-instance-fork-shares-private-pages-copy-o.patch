                u->start, end, (u->flags & PAGE_U) ? 'r' : '-',
-               (u->flags & PAGE_RW) ? 'w' : '-', (u->flags & PAGE_XD) ? '-' : 'x',
+               (u->flags & (PAGE_RW | PAGE_COWRW)) ? 'w' : '-', (u->flags & PAGE_XD) ? '-' : 'x',
                u->fm && u->fm->offset > 0 ? u->fm->offset + (u->start - u->fm->virt) : 0);
   u->n += k;
   if (u->fm && u->fm->path) {  // Linux pads the name to column 73
@@ -528,7 +530,7 @@ static void ShiroMapsEnd(struct ShiroMaps *u, i64 end) {
 }
 
