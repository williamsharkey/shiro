-  u64 flags = entry & (PAGE_U | PAGE_RW | PAGE_XD);
+  u64 flags = entry & (PAGE_U | PAGE_RW | PAGE_XD | PAGE_COWRW);
   int i;
   if (u->on && (flags != u->flags || addr >= u->limit)) ShiroMapsEnd(u, addr);
   if (!u->on) {
@@ -2001,6 +2003,7 @@ struct ShiroWalk {
   struct ShiroForkRun cur;
   u64 nruns;
   bool ok;
+  bool cow;  // same-instance child: private pages shared copy-on-write
 };
 
 static void ShiroCloseRun(struct ShiroWalk *w) {
@@ -2054,6 +2057,25 @@ static void ShiroWalkTable(struct ShiroWalk *w, u64 entry, int level, i64 base)
       continue;
     }
     u64 key = e & (PAGE_U | PAGE_RW | PAGE_XD);
+    if (w->cow && (e & (PAGE_U | PAGE_RW | PAGE_HOST | PAGE_MAP | PAGE_MUG | PAGE_RSRV | PAGE_GROW)) ==
+                      (PAGE_U | PAGE_RW | PAGE_HOST)) {
+      // a private page of its own: parent and child map it read-only, and the
+      // first to write it gets a copy (BreakCow). Not one a thread holds
+      // locked in a system call: its writes would land in the shared page
+      u8 *slot = table + i * 8;
+      u64 e2;
+      for (;;) {
+        if (e & PAGE_LOCKS) break;
+        e2 = (e & ~PAGE_RW) | PAGE_GROW | PAGE_COW | PAGE_COWRW;
+        if (CasPte(slot, e, e2)) {
+          ShareHostPage(FindHostPage(e));  // the parent's reference
+          e = e2;
+          break;
+        }
+        e = LoadPte(slot);
+        if (!(e & PAGE_V) || (e & PAGE_GROW)) break;
+      }
+    }
     if (e & PAGE_GROW) {
       // shared with a same-instance child: it maps this very host page
       ShareHostPage(FindHostPage(e));
@@ -2102,7 +2124,7 @@ static bool ShiroHasSharedMemory(struct System *s) {
 
