   }
@@ -2551,11 +2573,15 @@ static i64 ShiroForkSame(struct Machine *m, u64 flags, i64 stack, i64 ctid) {
   InvalidateSystem(s, true, false);
   ResetTlb(m);
   WjResetTlb(m);
-  if ((rc = ShiroSnapshot(m, flags, stack, ctid, &c->snap)) < 0) {
+  if ((rc = ShiroSnapshot(m, flags, stack, ctid, &c->snap, !g_shiro_nocow)) < 0) {
     free(c);
     KS(m, 62, A12(pid, 9));
