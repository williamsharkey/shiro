   }
+  // its pages are read-only now (copy on write): no cached writable entries
+  InvalidateSystem(s, true, false);
+  ResetTlb(m);
+  WjResetTlb(m);
   c->pid = pid;
   c->exec = s->exec;
   ++g_shiro_kids_starting;
