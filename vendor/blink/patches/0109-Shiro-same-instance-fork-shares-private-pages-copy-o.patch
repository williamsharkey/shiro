From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 07:06:28 +0000
Subject: [PATCH 109/111] Shiro: same-instance fork shares private pages
 copy-on-write

---
 blink/machine.h      |  8 +++++
 blink/memory.c       | 83 +++++++++++++++++++++++++++++++++++++++++++-
 blink/memorymalloc.c | 18 ++++++++++
 blink/shiro.inc      | 38 ++++++++++++++++----
 blink/syscall.c      | 20 ++++++-----
 blink/wjit.c         |  1 +
 6 files changed, 152 insertions(+), 16 deletions(-)

diff --git a/blink/machine.h b/blink/machine.h
index d4e42a4..f818607 100644
--- a/blink/machine.h
+++ b/blink/machine.h
@@ -105,6 +105,11 @@
 #define PAGE_LOCK  0x0080000000000000  // a bit used to increment lock counts
 #define PAGE_LOCKS 0x7f80000000000000  // a page can be locked by 255 threads
 #define PAGE_XD    0x8000000000000000  // disable executing memory if bit set
+// Shiro: a private page a same-instance fork left shared copy-on-write
+// (with PAGE_GROW: refcounted; PAGE_RW clear), and whether its mapping is
+// writable (a write gets this process its own copy)
+#define PAGE_COW   0x0002000000000000
+#define PAGE_COWRW 0x0004000000000000
 
 #define SREG_ES 0
 #define SREG_CS 1
@@ -674,6 +679,9 @@ void OpRetIw(P);
 void OpSsePclmulqdq(P);
 extern bool g_shiro_trace;
 bool ShiroInVfork(void);
+u64 BreakCow(struct Machine *, i64);
+u8 *LookupAddressWrite(struct Machine *, i64);
+long HostPageRefs(u8 *);
 bool ShiroTakeSiginfo(struct Machine *, int, u8 *);
 void ShiroQueueSiginfo(struct System *, int, const int *);
 void ShiroFreeSigq(struct System *);
diff --git a/blink/memory.c b/blink/memory.c
index 26b42eb..a3c0ada 100644
--- a/blink/memory.c
+++ b/blink/memory.c
@@ -32,6 +32,7 @@
 #include "blink/linux.h"
 #include "blink/log.h"
 #include "blink/machine.h"
+#include "blink/wjit.h"
 #include "blink/macros.h"
 #include "blink/pml4t.h"
 #include "blink/stats.h"
@@ -264,6 +265,67 @@ MapError:
   return (uintptr_t)efault0();
 }
 
+// the level-1 slot of `page`'s entry, or 0
+static u8 *FindPteSlot(struct Machine *m, i64 page) {
+  u64 entry = m->system->cr3;
+  u8 *pslot = 0;
+  int level;
+  for (level = 39; level >= 12; level -= 9) {
+    if (!(pslot = GetPageAddress(m->system, entry, level == 39))) return 0;
+    pslot += ((page >> level) & 511) * 8;
+    entry = LoadPte(pslot);
+    if (!(entry & PAGE_V)) return 0;
+    if ((entry & PAGE_PS) && level > 12) return 0;
+  }
+  return pslot;
+}
+
+// Gives this process its own copy of the copy-on-write page at `virt`
+// (PAGE_COW, left by a same-instance fork), or the page itself when no other
+// process maps it any more; returns the new entry (0: no memory).
+// Copies before dropping the reference: the other side may take the page
+// over and write it as soon as the count falls to one.
+u64 BreakCow(struct Machine *m, i64 virt) {
+  struct System *s = m->system;
+  u8 *pslot, *old, *np;
+  u64 entry, e2, n;
+  bool ok;
+  if (!(pslot = FindPteSlot(m, virt & -4096))) return 0;
+  for (;;) {
+    entry = LoadPte(pslot);
+    if (!(entry & PAGE_V)) return 0;
+    if (!(entry & PAGE_COW)) return entry;
+    old = (u8 *)FindHostPage(entry);
+    e2 = (entry & (PAGE_U | PAGE_XD | PAGE_LOCKS | PAGE_FILE)) | PAGE_V |
+         ((entry & PAGE_COWRW) ? PAGE_RW : 0);
+    if (HostPageRefs(old) <= 1) {
+      // the last mapper: the page is this process's again
+      e2 |= entry & (PAGE_TA | PAGE_HOST);
+      if (!CasPte(pslot, entry, e2)) continue;
+      UnshareHostPage(old);
+      break;
+    }
+    if ((n = AllocateAnonymousPage(s)) == (u64)-1) return 0;
+    np = (u8 *)FindHostPage(n);
+    memcpy(np, old, 4096);
+    e2 |= n & (PAGE_TA | PAGE_HOST);
+    ok = CasPte(pslot, entry, e2);
+    if (!ok) {
+      FreeAnonymousPage(s, np);  // another thread broke it first
+      continue;
+    }
+    if (!UnshareHostPage(old) && !(entry & PAGE_LOCKS)) {
+      memset(old, 0, 4096);  // the other mapper went away meanwhile (a
+      FreeAnonymousPage(s, old);  // page our own threads hold stays)
+    }
+    break;
+  }
+  if (!(entry & PAGE_XD)) WjPageChanged(virt & -4096);
+  InvalidateSystem(s, true, false);  // threads may hold the shared page's entry
+  ResetTlb(m);
+  return e2;
+}
+
 u8 *LookupAddress2(struct Machine *m, i64 virt, u64 mask, u64 need) {
   u8 *host;
   u64 entry;
@@ -280,6 +342,14 @@ u8 *LookupAddress2(struct Machine *m, i64 virt, u64 mask, u64 need) {
     m->segvcode = SEGV_MAPERR_LINUX;
     return (u8 *)efault0();
   }
+  // A page shared copy-on-write since a fork becomes this process's own as
+  // soon as Blink resolves an address in it: many of its paths write
+  // through a resolved pointer without checking PAGE_RW (only compiled
+  // code's inline reads keep sharing; its writes come here)
+  if ((entry & PAGE_COW) && !(entry = BreakCow(m, virt))) {
+    m->segvcode = SEGV_MAPERR_LINUX;
+    return (u8 *)enomem();
+  }
   if ((entry & mask) != need) {
     m->segvcode = SEGV_ACCERR_LINUX;
     return (u8 *)efault0();
@@ -299,6 +369,16 @@ u8 *LookupAddress2(struct Machine *m, i64 virt, u64 mask, u64 need) {
   }
 }
 
+// LookupAddress for Blink's own writes to guest memory (futex words, signal
+// frames, the clear-tid word): a copy-on-write page becomes this process's
+u8 *LookupAddressWrite(struct Machine *m, i64 virt) {
+  u64 entry;
+  if ((entry = FindPageTableEntry(m, virt & -4096)) && (entry & PAGE_COW) && !BreakCow(m, virt)) {
+    return (u8 *)enomem();
+  }
+  return LookupAddress(m, virt);
+}
+
 u8 *LookupAddress(struct Machine *m, i64 virt) {
   u64 need = 0;
   if (Cpl(m) == 3) need = PAGE_U;
@@ -363,6 +443,7 @@ bool IsValidMemory(struct Machine *m, i64 virt, i64 size, int prot) {
     if (!(pte = FindPageTableEntry(m, p))) {
       return false;
     }
+    if ((pte & PAGE_COWRW)) pte |= PAGE_RW;  // (writable: copied on write)
     if ((pte & mask) != need) {
       errno = EFAULT;
       return false;
@@ -377,7 +458,7 @@ int VirtualCopy(struct Machine *m, i64 v, char *r, u64 n, bool d) {
   k = 4096 - (v & 4095);
   while (n) {
     k = MIN(k, n);
-    if (!(p = LookupAddress(m, v))) return -1;
+    if (!(p = d ? LookupAddress(m, v) : LookupAddressWrite(m, v))) return -1;
     if (d) {
       memcpy(r, p, k);
     } else if (!IsRomAddress(m, p)) {
diff --git a/blink/memorymalloc.c b/blink/memorymalloc.c
index 8da4e5a..a1c38b0 100644
--- a/blink/memorymalloc.c
+++ b/blink/memorymalloc.c
@@ -162,6 +162,20 @@ void ShareHostPage(u8 *page) {
   UNLOCK(&g_shared_lock);
 }
 
+// how many processes map a shared host page (0: not shared)
+long HostPageRefs(u8 *page) {
+  uintptr_t k = (uintptr_t)page;
+  long i, r = 0;
+  LOCK(&g_shared_lock);
+  if (g_shared.c) {
+    for (i = SharedSlot(k); g_shared.key[i] && g_shared.key[i] != k; i = (i + 1) & (g_shared.c - 1)) {
+    }
+    if (g_shared.key[i]) r = g_shared.refs[i];
+  }
+  UNLOCK(&g_shared_lock);
+  return r;
+}
+
 // drops a reference; returns how many remain
 long UnshareHostPage(u8 *page) {
   uintptr_t k = (uintptr_t)page;
@@ -1429,6 +1443,10 @@ int ProtectVirtual(struct System *s, i64 virt, i64 size, int prot,
         if (!hostonly) {
           for (;;) {
             pt2 = (pt & ~(PAGE_U | PAGE_RW | PAGE_XD)) | key;
+            if (pt & PAGE_COW) {  // still shared: writable means copy on write
+              pt2 &= ~(PAGE_RW | PAGE_COWRW);
+              if (key & PAGE_RW) pt2 |= PAGE_COWRW;
+            }
             if (CasPte(mi, pt, pt2)) break;
             pt = LoadPte(mi);
             if (!(pt & PAGE_V)) {
