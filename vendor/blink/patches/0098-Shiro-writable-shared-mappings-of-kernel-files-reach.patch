From 43e78f70b59e15617ced4a3f9863a79d7b606093 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 06:45:52 +0000
Subject: [PATCH] Shiro: writable shared mappings of kernel files reach the
 file before a new mapping reads it, and at exit

A MAP_SHARED mapping of a kernel file is a copy written back on munmap
and msync, so a second mapping of the same file (shm_open_1-1), or the
parent mapping what a child wrote and left mapped at its exit
(shm_open_5-1), read the old bytes. A new mapping first writes back the
process's own writable shared mappings, and exit_group writes back and
drops them. Each map records its process: same-instance fork children
share the list but not the address space, so a sync only writes back
the caller's. Each map keeps a shadow of the bytes as last read or
written back (up to 64 MiB) and writes back only the runs that changed,
so a stale copy doesn't undo what a child wrote through its own mapping.

Exports blink_shiro_sharedmaps.
---
 blink/shiro.inc | 39 +++++++++++++++++++++++++++++++++++----
 blink/syscall.c |  2 ++
 2 files changed, 37 insertions(+), 4 deletions(-)

diff --git a/blink/shiro.inc b/blink/shiro.inc
index a3c0d69..e999d72 100644
--- a/blink/shiro.inc
+++ b/blink/shiro.inc
@@ -2285,6 +2285,8 @@ struct ShiroSharedMap {
   struct ShiroSharedMap *next;
   i64 addr, size, off;
   int fd;  // a kernel dup of the mapped fd
+  struct System *sys;  // the process that mapped it (same-instance children share the list)
+  u8 *shadow;  // the bytes as last read or written back (NULL above 64 MiB): only changes go back
 };
 static pthread_mutex_t_ g_shiro_maps_lock = PTHREAD_MUTEX_INITIALIZER_;
 
@@ -2349,6 +2351,8 @@ EMSCRIPTEN_KEEPALIVE int blink_shiro_timers(void) { return 1; }
 EMSCRIPTEN_KEEPALIVE int blink_shiro_siginfo(void) { return 1; }
 // 0096: raise of a blocked real-time signal queues in the kernel; sigprocmask and sigaltstack modes as Linux
 EMSCRIPTEN_KEEPALIVE int blink_shiro_sigmodes(void) { return 1; }
+// 0097/0098: write-only pages readable; shared kernel-file maps written back before a new map and at exit
+EMSCRIPTEN_KEEPALIVE int blink_shiro_sharedmaps(void) { return 1; }
 
 // the kernel signalled hosted child `pid` (host.mjs routes by pid)
 EMSCRIPTEN_KEEPALIVE void blink_shiro_signal_pid(int pid, int sig) {
@@ -2589,15 +2593,28 @@ static void ShiroWriteBack(struct Machine *m, struct ShiroSharedMap *s, i64 addr
   bool insyscall = m->insyscall;
   int rc;
   for (o = lo; buf && o < hi; o += g_shiro_chunk) {
-    int n = MIN(hi - o, (i64)g_shiro_chunk);
+    int n = MIN(hi - o, (i64)g_shiro_chunk), i, j;
     i64 at = s->off + (o - s->addr);
+    u8 *was = s->shadow ? s->shadow + (o - s->addr) : 0;
     // without page locks: a syscall's locks last until it returns, and the
     // munmap this is part of waits for the pages' locks to drain
     m->insyscall = false;
     rc = CopyFromUser(m, buf, o, n);
     m->insyscall = insyscall;
     if (rc == -1) break;
-    ShiroCall(m, 18, A12(s->fd, n, (int)at, (int)(at >> 32)), buf, n, 0, false, false);
+    if (!was) {
+      ShiroCall(m, 18, A12(s->fd, n, (int)at, (int)(at >> 32)), buf, n, 0, false, false);
+      continue;
+    }
+    // only the runs this process changed: another's writes to the file
+    // (a child's, through its own mapping) aren't undone by a stale copy
+    for (i = 0; i < n; i = j) {
+      if (buf[i] == was[i]) { j = i + 1; continue; }
+      for (j = i; j < n && (buf[j] != was[j] || (j + 64 < n && memcmp(buf + j, was + j, 64))); ++j) {}
+      i64 a2 = at + i;
+      ShiroCall(m, 18, A12(s->fd, j - i, (int)a2, (int)(a2 >> 32)), buf + i, j - i, 0, false, false);
+      memcpy(was + i, buf + i, j - i);
+    }
   }
   free(buf);
 }
@@ -2606,11 +2623,12 @@ static void ShiroSyncMaps(struct Machine *m, i64 addr, i64 size, bool drop) {
   struct ShiroSharedMap **pp, *s;
   LOCK(&g_shiro_maps_lock);
   for (pp = &g_shiro_maps; (s = *pp);) {
-    if (s->addr < addr + size && addr < s->addr + s->size) {
+    if (s->sys == m->system && s->addr < addr + size && addr < s->addr + s->size) {
       ShiroWriteBack(m, s, addr, size);
       if (drop && addr <= s->addr && s->addr + s->size <= addr + size) {
         *pp = s->next;
         KS(m, 3, A12(s->fd));
+        free(s->shadow);
         free(s);
         continue;
       }
@@ -2620,6 +2638,12 @@ static void ShiroSyncMaps(struct Machine *m, i64 addr, i64 size, bool drop) {
   UNLOCK(&g_shiro_maps_lock);
 }
 
+// exit_group: what the process's writable shared mappings of kernel files
+// hold goes to the files (Linux's page cache keeps it past the exit)
+void ShiroExitMaps(struct Machine *m) {
+  if (g_shiro_maps) ShiroSyncMaps(m, 0, (i64)1 << 47, true);
+}
+
 static i64 ShiroMmapFile(struct Machine *m, i64 virt, u64 size, int prot,
                          int flags, int fd, i64 off) {
   u8 st[144], *buf;
@@ -2631,6 +2655,9 @@ static i64 ShiroMmapFile(struct Machine *m, i64 virt, u64 size, int prot,
   if ((r = KS(m, 72, A12(fd, 3, 0))) < 0) return r;  // F_GETFL
   if (r & 010000000) return -EBADF_LINUX;
   if ((r & 3) == 1 || (shared && (prot & 2) && (r & 3) != 2)) return -EACCES_LINUX;
+  // what this instance's writable shared mappings hold goes to the files
+  // first, so a new mapping of one sees it (as one page cache would)
+  if (g_shiro_maps) ShiroSyncMaps(m, 0, (i64)1 << 47, false);
   if ((r = ShiroStatAt(m, fd, 0, 0, 0x1000, st)) < 0) return r;
   if ((Read32(st + 24) & 0170000) == 0040000) return -ENODEV_LINUX;
   fsize = Read64(st + 48);
@@ -2652,7 +2679,11 @@ static i64 ShiroMmapFile(struct Machine *m, i64 virt, u64 size, int prot,
   if (shared && (prot & 2)) {
     struct ShiroSharedMap *s = (struct ShiroSharedMap *)calloc(1, sizeof(*s));
     if (s) {
-      s->addr = addr, s->size = size, s->off = off;
+      s->addr = addr, s->size = size, s->off = off, s->sys = m->system;
+      if (size <= (64 << 20) && (s->shadow = (u8 *)malloc(size)) &&
+          CopyFromUser(m, s->shadow, addr, size) == -1) {
+        free(s->shadow), s->shadow = 0;
+      }
       s->fd = KS(m, 72, A12(fd, 1030, 3));
       LOCK(&g_shiro_maps_lock);
       s->next = g_shiro_maps;
diff --git a/blink/syscall.c b/blink/syscall.c
index 51697ca..a5031d2 100644
--- a/blink/syscall.c
+++ b/blink/syscall.c
@@ -459,6 +459,8 @@ _Noreturn void SysExitGroup(struct Machine *m, int rc) {
       _Noreturn void ShiroInstanceChildExit(struct Machine *, int);
       bool ShiroParentExitWithKids(struct Machine *, int);
       void ShiroQuiesce(struct Machine *);
+      void ShiroExitMaps(struct Machine *);
+      ShiroExitMaps(m);
       if (ShiroIsInstanceChild(m)) ShiroInstanceChildExit(m, rc);
       ShiroParentExitWithKids(m, rc);
       ShiroQuiesce(m);
-- 
2.43.0

