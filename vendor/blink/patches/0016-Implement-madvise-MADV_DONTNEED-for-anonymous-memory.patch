From f2eee011aa804330b9f0f58adf7cffb9f99f3d96 Mon Sep 17 00:00:00 2001
From: Shiro <shiro@localhost>
Date: Thu, 8 Oct 2026 20:06:19 +0000
Subject: [PATCH 16/20] Implement madvise(MADV_DONTNEED) for anonymous memory
 (jemalloc checks that pages read back as zeros)

---
 blink/syscall.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/blink/syscall.c b/blink/syscall.c
index d075ada..3206ef9 100644
--- a/blink/syscall.c
+++ b/blink/syscall.c
@@ -1112,6 +1112,24 @@ static int SysMprotect(struct Machine *m, i64 addr, u64 size, int prot) {
 }
 
 static int SysMadvise(struct Machine *m, i64 addr, u64 len, int advice) {
+  i64 p, end;
+  u64 e;
+  u8 *h;
+  // MADV_DONTNEED: private anonymous memory reads back as zeros afterwards
+  // (jemalloc checks this; it falls back to memset and warns otherwise)
+  if (advice == 4 && !(addr & 4095) && len && IsValidAddrSize(addr, len)) {
+    end = addr + ROUNDUP(len, 4096);
+    BEGIN_NO_PAGE_FAULTS;
+    LOCK(&m->system->mmap_lock);
+    for (p = addr; p < end; p += 4096) {
+      e = FindPageTableEntry(m, p);
+      if ((e & (PAGE_V | PAGE_U | PAGE_RW)) != (PAGE_V | PAGE_U | PAGE_RW)) continue;
+      if (e & (PAGE_RSRV | PAGE_FILE | PAGE_MAP)) continue;  // untouched, or file
+      if ((h = GetPageAddress(m->system, e, false))) memset(h, 0, 4096);
+    }
+    UNLOCK(&m->system->mmap_lock);
+    END_NO_PAGE_FAULTS;
+  }
   return 0;
 }
 
