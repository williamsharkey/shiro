 blink/machine.c      |    9 +
 blink/machine.h      |    4 +
 blink/memorymalloc.c |    3 +
 blink/reset.c        |    1 +
 blink/wjit.c         | 2804 ++++++++++++++++++++++++++++++++++++++++++
 blink/wjit.h         |   35 +
 7 files changed, 2859 insertions(+)
 create mode 100644 blink/wjit.c
 create mode 100644 blink/wjit.h

