+#include "blink/wjit.h"
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "blink/biosrom.h"
+#include "blink/bus.h"
+#include "blink/endian.h"
+#include "blink/flags.h"
