From d866f981a365b2089e2d5ed21ae272eb02daa72b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 8 Oct 2026 23:33:20 +0000
Subject: [PATCH 22/22] lzcnt returns the leading zero count; one-operand
 imul32 zero-extends rdx; 4096-entry decoded-instruction cache

LZCNT (F3 0F BD) returned bsr's bit index. The 32-bit one-operand IMUL
stored the sign-extended high half in all of %rdx; a 32-bit result zero
extends. The instruction cache had 512 direct-mapped entries, so code that
runs a few hundred times (Go's init, before the wasm JIT takes it) was
decoded again on most visits: 4096 entries (160 KB per thread) cut
gh --version's decodes from 3.2M to 1.4M.
---
 blink/divmul.c  | 2 +-
 blink/machine.c | 2 +-
 blink/machine.h | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/blink/divmul.c b/blink/divmul.c
index 395fda2..769a1a2 100644
--- a/blink/divmul.c
+++ b/blink/divmul.c
@@ -338,7 +338,7 @@ void OpMulRdxRaxEvqpSigned(P) {
     i64 edxeax = (i64)(i32)Get32(m->ax) * (i32)Load32(p);
     unsigned of = edxeax != (i32)edxeax;
     Put64(m->ax, (u32)edxeax);
-    Put64(m->dx, edxeax >> 32);
+    Put64(m->dx, (u32)(edxeax >> 32));
     m->flags = SetFlag(m->flags, FLAGS_CF, of);
     m->flags = SetFlag(m->flags, FLAGS_OF, of);
   } else {
diff --git a/blink/machine.c b/blink/machine.c
index 45b80b3..d64cbfe 100644
--- a/blink/machine.c
+++ b/blink/machine.c
@@ -1068,7 +1068,7 @@ static u64 AluBsf(u64 x, struct Machine *m) {
 }
 
 static u64 AluTzcnt(u64 x, struct Machine *m, int bits) {
-  u64 r = x ? bsr(x) : bits;
+  u64 r = x ? bits - 1 - bsr(x) : bits;  // lzcnt (the names are swapped)
   m->flags = SetFlag(m->flags, FLAGS_CF, !x);
   m->flags = SetFlag(m->flags, FLAGS_ZF, !r);
   return r;
diff --git a/blink/machine.h b/blink/machine.h
index 06f640e..45a0efb 100644
--- a/blink/machine.h
+++ b/blink/machine.h
@@ -260,7 +260,7 @@ struct OpCache {
   u32 stashsize;  // for writes that overlap page
   bool writable;
   _Atomic(bool) invalidated;
-  u64 icache[512][kInstructionBytes / 8];
+  u64 icache[4096][kInstructionBytes / 8];
 };
 
 struct System {
