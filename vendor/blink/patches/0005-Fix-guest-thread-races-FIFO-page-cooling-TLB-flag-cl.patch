diff --git a/blink/memorymalloc.c b/blink/memorymalloc.c
index 7d5cc93..8329696 100644
--- a/blink/memorymalloc.c
+++ b/blink/memorymalloc.c
@@ -43,9 +43,18 @@
 #include "blink/util.h"
 #include "blink/x86.h"
 
+// Freed pages (data and page tables) cool off in a FIFO before reuse.
+// Other threads walk page tables without locks and may still hold a TLB
+// entry until they notice their invalidation flag, so handing a page out
+// again right away (LIFO) let them read or write someone else's memory.
+#define kCoolingPages 2048
+
 struct Allocator {
   pthread_mutex_t_ lock;
   struct HostPage *pages GUARDED_BY(lock);
+  struct HostPage *cool_head GUARDED_BY(lock);
+  struct HostPage *cool_tail GUARDED_BY(lock);
+  long cool_count GUARDED_BY(lock);
 } g_allocator = {
     PTHREAD_MUTEX_INITIALIZER_,
 };
@@ -91,8 +100,20 @@ void FreeAnonymousPage(struct System *s, u8 *page) {
   unassert((h = NewHostPage()));
   LOCK(&g_allocator.lock);
   h->page = page;
-  h->next = g_allocator.pages;
-  g_allocator.pages = h;
+  h->next = 0;
+  if (g_allocator.cool_tail) {
+    g_allocator.cool_tail->next = h;
+  } else {
+    g_allocator.cool_head = h;
+  }
+  g_allocator.cool_tail = h;
+  if (++g_allocator.cool_count > kCoolingPages) {
+    h = g_allocator.cool_head;
+    if (!(g_allocator.cool_head = h->next)) g_allocator.cool_tail = 0;
+    --g_allocator.cool_count;
+    h->next = g_allocator.pages;
+    g_allocator.pages = h;
+  }
   UNLOCK(&g_allocator.lock);
 }
 
@@ -749,8 +770,10 @@ static void RemoveVirtual(struct System *s, i64 virt, i64 size,
         // crawl an old pointer to a free page table. free page
         // tables may be crawled because they always get zero'd
         // before being put into a freelist fifo that cools off
-        FreePageTable(s, GetPageAddress(s, LoadPte(pde), i == 39));
+        // unlink before freeing, so new walks can't reach the table
+        pt = LoadPte(pde);
         StorePte(pde, 0);
+        FreePageTable(s, GetPageAddress(s, pt, i == 39));
       }
       break;
     }
