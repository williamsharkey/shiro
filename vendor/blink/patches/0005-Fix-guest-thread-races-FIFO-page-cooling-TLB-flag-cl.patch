From baddd29482d550faef57361db9226a5e8524047b Mon Sep 17 00:00:00 2001
From: shiro <x@x>
Date: Thu, 8 Oct 2026 00:08:10 +0000
Subject: [PATCH 5/9] Fix guest-thread races: FIFO page cooling, TLB flag
 clear-then-flush, GIL

- Freed pages went back on a LIFO list and were handed out again at once,
  while other threads could still be walking a freed page table or hold
  the page in a TLB entry they hadn't flushed yet. Freed pages now cool
  off in a FIFO before reuse, and page tables are unlinked before freeing.
- FindPageTableEntry() and LoadInstruction2() cleared the invalidation
  flag after flushing, losing invalidations posted in between.
- A global interpreter lock (blink/gil.c) runs one guest thread at a time,
  released around blocking syscalls and every 4096 instructions. On by
  default for emscripten (BLINK_GIL=1 elsewhere). Go net/http under the
  software MMU went from ~1 in 5 runs faulting to 0 in 70.
- emscripten exit() tells the embedder first (Module.shiroExit), since
  runtime teardown could wedge on threads parked in proxied syscalls.
---
 blink/blink.c        |  12 +++--
 blink/gil.c          | 113 +++++++++++++++++++++++++++++++++++++++++++
 blink/gil.h          |  22 +++++++++
 blink/instruction.c  |   6 +--
 blink/machine.c      |   7 +++
 blink/memory.c       |   8 ++-
 blink/memorymalloc.c |  29 +++++++++--
 blink/syscall.c      |   6 +++
 8 files changed, 191 insertions(+), 12 deletions(-)
 create mode 100644 blink/gil.c
 create mode 100644 blink/gil.h

diff --git a/blink/blink.c b/blink/blink.c
index c8b6e75..03ce188 100644
--- a/blink/blink.c
+++ b/blink/blink.c
@@ -49,6 +49,7 @@
 #include "blink/util.h"
 #include "blink/vfs.h"
 #include "blink/web.h"
+#include "blink/gil.h"
 #include "blink/x86.h"
 #include "blink/xlat.h"
 
@@ -352,16 +353,19 @@ static void HandleSigs(void) {
 #if defined(__EMSCRIPTEN__)
 void exit(int status) {
   // main is called multiple times - don't perform cleanup. _exit() from
-  // a PROXY_TO_PTHREAD main thread never tears the runtime down, so the
-  // embedder would wait forever; force the exit through to JavaScript.
-  fflush(stdout);
-  fflush(stderr);
+  // a PROXY_TO_PTHREAD main thread never tears the runtime down, and the
+  // teardown itself can wedge on threads stuck in proxied syscalls, so
+  // first tell the embedder directly (Module.shiroExit runs on the main
+  // runtime thread), then force the exit through to JavaScript.
+  MAIN_THREAD_ASYNC_EM_ASM({ if (Module['shiroExit']) Module['shiroExit']($0); },
+                           status);
   emscripten_force_exit(status);
   _exit(status);
 }
 #endif
 
 int main(int argc, char *argv[]) {
+  GilInit();
   SetupWeb();
   GetStartDir();
 #ifndef NDEBUG
diff --git a/blink/gil.c b/blink/gil.c
new file mode 100644
index 0000000..76811fe
--- /dev/null
+++ b/blink/gil.c
@@ -0,0 +1,113 @@
+/*-*- mode:c;indent-tabs-mode:nil;c-basic-offset:2;tab-width:8;coding:utf-8 -*-│
+│ vi: set et ft=c ts=2 sts=2 sw=2 fenc=utf-8                               :vi │
+╞══════════════════════════════════════════════════════════════════════════════╡
+│ Global interpreter lock for guest threads (a FIFO ticket lock).              │
+│ Copyright 2026 Shiro contributors. ISC license, same terms as Blink.         │
+╚─────────────────────────────────────────────────────────────────────────────*/
+#include "blink/gil.h"
+
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "blink/assert.h"
+#include "blink/atomic.h"
+
+bool g_gil_enabled;
+
+static pthread_mutex_t g_gil_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t g_gil_cond = PTHREAD_COND_INITIALIZER;
+static unsigned long g_gil_next;      // next ticket to hand out
+static unsigned long g_gil_serving;   // ticket allowed to run
+static _Atomic(int) g_gil_waiters;
+static _Thread_local bool t_gil_held;
+
+void GilInit(void) {
+  const char *s = getenv("BLINK_GIL");
+#ifdef __EMSCRIPTEN__
+  g_gil_enabled = !s || strcmp(s, "0");
+#else
+  g_gil_enabled = s && strcmp(s, "0");
+#endif
+}
+
+bool GilHeld(void) {
+  return t_gil_held;
+}
+
+void GilAcquire(void) {
+  unsigned long ticket;
+  if (!g_gil_enabled || t_gil_held) return;
+  atomic_fetch_add(&g_gil_waiters, 1);
+  pthread_mutex_lock(&g_gil_lock);
+  ticket = g_gil_next++;
+  while (ticket != g_gil_serving) {
+    pthread_cond_wait(&g_gil_cond, &g_gil_lock);
+  }
+  pthread_mutex_unlock(&g_gil_lock);
+  atomic_fetch_sub(&g_gil_waiters, 1);
+  t_gil_held = true;
+}
+
+void GilRelease(void) {
+  if (!t_gil_held) return;
+  t_gil_held = false;
+  pthread_mutex_lock(&g_gil_lock);
+  ++g_gil_serving;
+  pthread_cond_broadcast(&g_gil_cond);
+  pthread_mutex_unlock(&g_gil_lock);
+}
+
+void GilYield(void) {
+  if (t_gil_held && atomic_load(&g_gil_waiters)) {
+    GilRelease();
+    GilAcquire();
+  }
+}
+
+// After fork() only the calling thread exists in the child.
+void GilAfterFork(void) {
+  bool held = t_gil_held;
+  pthread_mutex_init(&g_gil_lock, 0);
+  pthread_cond_init(&g_gil_cond, 0);
+  g_gil_next = g_gil_serving = held;
+  atomic_store(&g_gil_waiters, 0);
+}
+
+// System calls that may block and don't change the address space. These
+// run without the lock so other guest threads keep going meanwhile.
+bool GilReleasesFor(unsigned long sysno) {
+  switch (sysno) {
+    case 0x000:  // read
+    case 0x001:  // write
+    case 0x007:  // poll
+    case 0x011:  // pread64
+    case 0x012:  // pwrite64
+    case 0x013:  // readv
+    case 0x014:  // writev
+    case 0x017:  // select
+    case 0x018:  // sched_yield
+    case 0x022:  // pause
+    case 0x023:  // nanosleep
+    case 0x02A:  // connect
+    case 0x02B:  // accept
+    case 0x02C:  // sendto
+    case 0x02D:  // recvfrom
+    case 0x02E:  // sendmsg
+    case 0x02F:  // recvmsg
+    case 0x03D:  // wait4
+    case 0x080:  // rt_sigtimedwait
+    case 0x082:  // rt_sigsuspend
+    case 0x0CA:  // futex
+    case 0x0E6:  // clock_nanosleep
+    case 0x0E8:  // epoll_wait
+    case 0x10E:  // pselect6
+    case 0x10F:  // ppoll
+    case 0x119:  // epoll_pwait
+    case 0x120:  // accept4
+    case 0x1B9:  // epoll_pwait2
+      return true;
+    default:
+      return false;
+  }
+}
diff --git a/blink/gil.h b/blink/gil.h
new file mode 100644
index 0000000..6a610a2
--- /dev/null
+++ b/blink/gil.h
@@ -0,0 +1,22 @@
+#ifndef BLINK_GIL_H_
+#define BLINK_GIL_H_
+#include <stdbool.h>
+
+// Global interpreter lock: at most one guest thread executes instructions
+// at a time. Threads give it up around blocking system calls and every
+// kGilSlice instructions, in FIFO order. On by default for emscripten
+// builds (and with BLINK_GIL=1 elsewhere): Blink's software MMU and some
+// of its bookkeeping race when guest threads really run in parallel.
+#define kGilSlice 4096
+
+extern bool g_gil_enabled;
+
+void GilInit(void);
+void GilAcquire(void);
+void GilRelease(void);
+void GilYield(void);
+void GilAfterFork(void);
+bool GilHeld(void);
+bool GilReleasesFor(unsigned long sysno);
+
+#endif /* BLINK_GIL_H_ */
