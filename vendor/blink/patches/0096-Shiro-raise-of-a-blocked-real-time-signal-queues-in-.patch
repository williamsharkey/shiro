From ccae765a3155c3edbc72c415d4060cc98a443bd6 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 05:46:42 +0000
Subject: [PATCH] Shiro: raise of a blocked real-time signal queues in the
 kernel; SIGKILL/SIGSTOP stay unblocked; sigaltstack modes as Linux

Blink's pending set holds one of each signal, so raise(SIGRTMIN) twice
while it's blocked was taken once by sigwait and the second wait never
returned (Open POSIX sigwait_2-1). The kernel queues each instance with
SI_TKILL. sigprocmask leaves SIGKILL and SIGSTOP out of the mask
(sigprocmask_10-1, pthread_sigmask_10-1). sigaltstack refuses
SS_ONSTACK|SS_DISABLE, and a disabled stack reads back as ss_sp NULL,
ss_size 0 (sigaltstack_2-1, 11-1).

rt_sigaction mirrors SIGCHLD's SA_NOCLDSTOP and SA_NOCLDWAIT to the kernel, which
skips stop reports and reaps
the children as they exit (sigaction_21-1).

Exports blink_shiro_sigmodes.
---
 blink/shiro.inc | 35 +++++++++++++++++++++++++++++------
 blink/syscall.c | 15 ++++++++++++++-
 2 files changed, 43 insertions(+), 7 deletions(-)

diff --git a/blink/shiro.inc b/blink/shiro.inc
index 1f2d523..a3c0d69 100644
--- a/blink/shiro.inc
+++ b/blink/shiro.inc
@@ -1676,11 +1676,14 @@ static i64 ShiroWaitid(struct Machine *m, int idtype, int id, i64 info,
 }
 
 // The kernel's view of a guest handler: caught signals are forwarded here.
-static i64 ShiroMirrorSigaction(struct Machine *m, int sig, u64 handler) {
+static i64 ShiroMirrorSigaction(struct Machine *m, int sig, u64 handler, u64 flags) {
   u8 act[64];
   memset(act, 0, sizeof(act));
   if (sig == 9 || sig == 19) return 0;
   Write64(act, handler == SIG_DFL_LINUX ? 0 : handler == SIG_IGN_LINUX ? 1 : K_FWD_HANDLER);
+  // SIGCHLD's SA_NOCLDSTOP (no SIGCHLD for a child's stop or continue) and
+  // SA_NOCLDWAIT (the kernel reaps the children as they exit: no zombies)
+  if (sig == 17) Write64(act + 8, flags & 3);
   return ShiroCall(m, 13, A12(sig, 1, 0), act, 64, 0, false, false);
 }
 
@@ -1692,7 +1695,7 @@ static i64 ShiroVforkSigaction(struct Machine *m, int sig, i64 act, i64 old,
   if (old && CopyToUserWrite(m, old, h, sizeof(*h)) == -1) return -EFAULT_LINUX;
   if (act) {
     if (CopyFromUserRead(m, h, act, sizeof(*h)) == -1) return -EFAULT_LINUX;
-    ShiroMirrorSigaction(m, sig, Read64(h->handler));
+    ShiroMirrorSigaction(m, sig, Read64(h->handler), Read64(h->flags));
   }
   return 0;
 }
@@ -1702,7 +1705,7 @@ static i64 ShiroVforkSigaction(struct Machine *m, int sig, i64 act, i64 old,
 // TerminateSignal() instead of terminating.
 bool ShiroStopSelf(struct Machine *m, int sig) {
   if (!g_shiro_pid || (sig != 19 && sig != 20 && sig != 21 && sig != 22)) return false;
-  ShiroMirrorSigaction(m, sig, SIG_DFL_LINUX);
+  ShiroMirrorSigaction(m, sig, SIG_DFL_LINUX, 0);
   KS(m, 62, A12(m->system->pid, sig));
   KS(m, 24, A12(0));  // sched_yield: answered once we're continued
   return true;
@@ -2344,6 +2347,8 @@ EMSCRIPTEN_KEEPALIVE int blink_shiro_mqueue(void) { return 1; }
 EMSCRIPTEN_KEEPALIVE int blink_shiro_timers(void) { return 1; }
 // 0092: rt_sigqueueinfo carries its siginfo to the kernel
 EMSCRIPTEN_KEEPALIVE int blink_shiro_siginfo(void) { return 1; }
+// 0096: raise of a blocked real-time signal queues in the kernel; sigprocmask and sigaltstack modes as Linux
+EMSCRIPTEN_KEEPALIVE int blink_shiro_sigmodes(void) { return 1; }
 
 // the kernel signalled hosted child `pid` (host.mjs routes by pid)
 EMSCRIPTEN_KEEPALIVE void blink_shiro_signal_pid(int pid, int sig) {
@@ -3117,9 +3122,26 @@ static bool ShiroSyscall(struct Machine *m, int nr, u64 a, u64 b, u64 c,
       // SIGKILL or SIGSTOP to the calling thread (raise) is the kernel's to
       // act on: Blink would raise it on the host, where nothing ends or
       // stops the guest process and its parent's wait never returns
+      // A blocked real-time signal raised on the calling thread goes to the
+      // kernel too, which queues every instance (Blink's pending set holds
+      // one of each): raise(SIGRTMIN) twice is taken twice by sigwait
       int tid = nr == 0x0C8 ? (int)a : (int)b, sig = nr == 0x0C8 ? (int)b : (int)c;
-      if ((sig != 9 && sig != 19) || tid != m->tid || (nr == 0x0EA && (int)a != m->system->pid)) return false;
-      r = KS(m, 62, A12(m->system->pid, sig));                       // kill
+      if (tid != m->tid || (nr == 0x0EA && (int)a != m->system->pid)) return false;
+      if (sig == 9 || sig == 19) {
+        r = KS(m, 62, A12(m->system->pid, sig));                     // kill
+        break;
+      }
+      if (sig < 32 || sig > 64 || !(m->sigmask & ((u64)1 << (sig - 1)))) return false;
+      {
+        u8 si[128];
+        memset(si, 0, sizeof(si));
+        Write32(si, sig);
+        Write32(si + 8, (u32)-6);                                     // si_code SI_TKILL
+        Write32(si + 16, m->system->pid);
+        Write32(si + 20, (u32)KS(m, 102, A12(0)));                     // getuid
+        r = ShiroCall(m, 129, A12(m->system->pid, sig), si, sizeof(si), 0, false, false);
+        if (r == -ENOSYS_LINUX) return false;
+      }
       break;
     }
     case 0x080: {                                                     // rt_sigtimedwait
@@ -3702,8 +3724,9 @@ static bool ShiroSyscall(struct Machine *m, int nr, u64 a, u64 b, u64 c,
       if (r == 0 && b && a >= 1 && a <= 64) {
         LOCK(&m->system->sig_lock);
         u64 h = Read64(m->system->hands[a - 1].handler);
+        u64 f = Read64(m->system->hands[a - 1].flags);
         UNLOCK(&m->system->sig_lock);
-        ShiroMirrorSigaction(m, a, h);
+        ShiroMirrorSigaction(m, a, h, f);
       }
       break;
     }
diff --git a/blink/syscall.c b/blink/syscall.c
index b477722..51697ca 100644
--- a/blink/syscall.c
+++ b/blink/syscall.c
@@ -4741,6 +4741,11 @@ static int SysSigaltstack(struct Machine *m, i64 newaddr, i64 oldaddr) {
       LOGF("unsupported %s flags: %#x", "sigaltstack", unsupported);
       return einval();
     }
+    // the mode is one of 0, SS_ONSTACK or SS_DISABLE (Linux), not both
+    if ((Read32(ss->flags) & ~SS_AUTODISARM_LINUX) ==
+        (SS_ONSTACK_LINUX | SS_DISABLE_LINUX)) {
+      return einval();
+    }
     if (~Read32(ss->flags) & SS_DISABLE_LINUX) {
       if (Read64(ss->size) < MINSIGSTKSZ_LINUX) {
         LOGF("sigaltstack ss_size=%#" PRIx64 " must be at least %#x",
@@ -4767,6 +4772,12 @@ static int SysSigaltstack(struct Machine *m, i64 newaddr, i64 oldaddr) {
   }
   if (ss) {
     memcpy(&m->sigaltstack, ss, sizeof(*ss));
+    // a disabled stack reads back as none: ss_sp NULL, ss_size 0 (Linux)
+    if (Read32(ss->flags) & SS_DISABLE_LINUX) {
+      Write64(m->sigaltstack.sp, 0);
+      Write64(m->sigaltstack.size, 0);
+      Write32(m->sigaltstack.flags, SS_DISABLE_LINUX);
+    }
   }
   return 0;
 }
@@ -5532,7 +5543,9 @@ static int SysSigprocmask(struct Machine *m, int how, i64 setaddr,
     }
   }
   if (setaddr) {
-    set = Read64(neu);
+    // SIGKILL and SIGSTOP can't be blocked: they're left out, not refused
+    set = Read64(neu) & ~(((u64)1 << (SIGKILL_LINUX - 1)) |
+                          ((u64)1 << (SIGSTOP_LINUX - 1)));
     if (how == SIG_BLOCK_LINUX) {
       m->sigmask |= set;
     } else if (how == SIG_UNBLOCK_LINUX) {
-- 
2.43.0

