 blink/gil.h     |   1 +
 blink/machine.c |   3 +
 blink/machine.h |  23 +++
 blink/memory.c  |  19 +-
 blink/shiro.inc | 463 +++++++++++++++++++++++++++++++++++++++++++++++-
 blink/syscall.c |   8 +
 blink/wjit.c    |   3 +-
 8 files changed, 520 insertions(+), 3 deletions(-)

