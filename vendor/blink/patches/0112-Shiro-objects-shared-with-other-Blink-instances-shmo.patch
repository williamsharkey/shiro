 #ifndef DISABLE_JIT
   if ((need & PAGE_RW) &&
       (entry & (PAGE_U | PAGE_RW | PAGE_XD)) == (PAGE_U | PAGE_RW) &&
@@ -458,6 +466,14 @@ int VirtualCopy(struct Machine *m, i64 v, char *r, u64 n, bool d) {
   k = 4096 - (v & 4095);
   while (n) {
     k = MIN(k, n);
+    if (!m->metal && (FindPageTableEntry(m, v & -4096) & PAGE_REMOTE)) {
+      if (ShiroRemoteCopy(m, v, r, k, d) == -1) return -1;
