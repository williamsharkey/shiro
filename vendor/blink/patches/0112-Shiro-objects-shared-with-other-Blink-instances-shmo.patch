@@ -2651,6 +2657,456 @@ _Noreturn void ShiroInstanceChildKilled(struct Machine *m, int sig) {
 }
 
 
+// ── Objects shared with other Blink instances (shmobj) ──────────────────
+//
+// docs/research/SHARED_MAPPINGS.md. A MAP_SHARED mapping of a /dev/shm file
+// or a memfd is one object for every Blink instance (worker) that maps it:
+// its bytes live in a SharedArrayBuffer the kernel owns (shiro_shmobj_map,
+// 1020, asked for remote at once: kind 0x100). This instance maps shadow
+// pages marked PAGE_REMOTE, which no TLB caches, so every access comes
+// through LookupAddress2 here: an instruction locks the object (a word in
+// the buffer) and refreshes the page from it; the thread keeps both for the
+// next instructions, briefly (a lease: kShiroLeaseMs, and never past a
+// system call or the GIL), then writes its pages back and unlocks. So an
+// instruction is atomic as a lock prefix needs, and a run of accesses
+// costs one round trip to the buffer, not one each. A system call
+// may block, so it locks only for its copies, and writes back what it
+// changed (against a twin of what it read). Futexes on such words wait and
+// wake on the buffer itself (Atomics), across instances.
+//
+// The buffer is only in the instance's main JS thread (host.mjs), which
+// these calls reach (shiro-kernel.js); BLINK_SHMOBJ=0 maps such files the
+// old way (a private copy, written back).
+
+extern int shiro_shm_io(int id, u32 off, void *p, int n, int dir);
+extern int shiro_shm_diff(int id, u32 off, const void *p, const void *twin, int n);
+extern int shiro_shm_acquire(int id, u32 off, void *p, int *flag, int how);
+extern int shiro_shm_release(int id, u32 off, const void *p);
+extern int shiro_shm_watch(int id, u32 off, u32 expect, int *flag, int ms);
+extern int shiro_shm_wake(int id, u32 off, int n);
+
+#define SHIRO_NOT_REMOTE (-100000)
+#define kShiroLeaseMs    0.5  // how long a thread may keep an object locked between instructions
+
+struct ShiroRemoteObj {  // one kernel mapping (1020), shared by fork copies
+  int id, refs;
+};
+struct ShiroRemoteMap {
+  struct ShiroRemoteMap *next;
+  int pid;
+  i64 addr, size;
+  u32 off;
+  struct ShiroRemoteObj *obj;
+};
+static struct ShiroRemoteMap *g_shiro_remote;
+static pthread_mutex_t_ g_shiro_remote_lock = PTHREAD_MUTEX_INITIALIZER_;
+
+static bool ShiroRemoteFind(int pid, i64 virt, int *id, u32 *off) {
+  struct ShiroRemoteMap *r;
+  bool ok = false;
+  LOCK(&g_shiro_remote_lock);
+  for (r = g_shiro_remote; r; r = r->next) {
+    if (r->pid == pid && r->addr <= virt && virt < r->addr + r->size) {
+      *id = r->obj->id;
+      *off = r->off + (u32)(virt - r->addr);
+      ok = true;
+      break;
+    }
+  }
+  UNLOCK(&g_shiro_remote_lock);
+  return ok;
+}
+
+// Locks object `id` for this thread, copying its page at `off` into `host`
+// (if host) in the same call; false if the thread held it already (then
+// nothing is copied). A newcomer lets the threads already waiting go first.
+static bool ShiroRemoteLock(struct Machine *m, int id, u32 off, u8 *host) {
+  int i, n, how = 0;
+  for (i = 0; i < m->nrlocks; ++i) {
+    if (m->rlocks[i] == id) return false;
+  }
+  for (n = 0;; ++n) {
+    m->rflag = 0;
+    if (shiro_shm_acquire(id, off, host, &m->rflag, how)) break;
+    how = 1;
+    if (n == 20) {  // ~2 s: its holder died with it (a crashed instance)
+      LOGF("shared object %d stayed locked; taking it over", id);
+      how = 3;
+      continue;
+    }
+    while (!atomic_load_explicit((_Atomic(int) *)&m->rflag, memory_order_acquire)) {
+      emscripten_futex_wait(&m->rflag, 0, 200);
+    }
+  }
+  if (m->nrlocks < (int)ARRAYLEN(m->rlocks)) {
+    if (!m->nrlocks) m->rlockt = emscripten_get_now();
+    m->rlocks[m->nrlocks++] = id;
+  } else {
+    LOGF("too many shared objects in one instruction");
+  }
+  return true;
+}
+
+// Unlocks `id`, writing the page at `host` back to `off` first (if host)
+static void ShiroRemoteUnlock(struct Machine *m, int id, u32 off, u8 *host) {
+  int i;
+  for (i = 0; i < m->nrlocks; ++i) {
+    if (m->rlocks[i] == id) {
+      m->rlocks[i] = m->rlocks[--m->nrlocks];
+      break;
+    }
+  }
+  shiro_shm_release(id, off, host);
+}
+
+// LookupAddress2 of a remote page (`host`: its shadow)
+u8 *ShiroRemoteAccess(struct Machine *m, i64 virt, u8 *host) {
+  struct ShiroRemoteSlot *s;
+  i64 page = virt & -4096;
+  u32 off;
+  int i, id;
+  for (i = 0; i < m->nrslot; ++i) {
+    if (m->rslot[i].page == page) return host + (virt & 4095);
+  }
+  if (m->nrslot == (int)ARRAYLEN(m->rslot) ||
+      !ShiroRemoteFind(m->system->pid, page, &id, &off)) {
+    LOGF("remote page %#" PRIx64 " not tracked", page);
+    return host + (virt & 4095);
+  }
+  s = m->rslot + m->nrslot;
+  s->page = page;
+  s->host = host;
+  s->id = id;
+  s->off = off;
+  s->twin = 0;
+  if (m->insyscall) {
+    // it may block: locked only to copy; what it changes goes back as a diff
+    if (!(s->twin = (u8 *)malloc(4096))) return host + (virt & 4095);
+    if (ShiroRemoteLock(m, id, off, host)) {
+      ShiroRemoteUnlock(m, id, 0, 0);
+    } else {
+      shiro_shm_io(id, off, host, 4096, 0);
+    }
+    memcpy(s->twin, host, 4096);
+  } else if (!ShiroRemoteLock(m, id, off, host)) {
+    shiro_shm_io(id, off, host, 4096, 0);  // (another page of an object it holds)
+  }
+  ++m->nrslot;
+  if (!m->stashaddr) m->stashaddr = SHIRO_STASH_REMOTE;
+  return host + (virt & 4095);
+}
+
+// The objects this thread holds go back, with what it wrote to their pages
+void ShiroRemoteRelease(struct Machine *m) {
+  struct ShiroRemoteSlot *s;
+  u8 *host;
+  u32 off;
+  int i, j, id;
+  while (m->nrlocks) {
+    id = m->rlocks[m->nrlocks - 1];
+    host = 0, off = 0;
+    for (i = j = 0; i < m->nrslot; ++i) {
+      s = m->rslot + i;
+      if (s->twin || s->id != id) {
+        m->rslot[j++] = *s;
+        continue;
+      }
+      if (host) shiro_shm_io(id, off, host, 4096, 1);
+      host = s->host, off = s->off;  // (the last one goes with the release)
+    }
+    m->nrslot = j;
+    ShiroRemoteUnlock(m, id, off, host);
+  }
+}
+
+// A system call's pages go back (what it changed)
+static void ShiroRemoteFlushTwins(struct Machine *m) {
+  struct ShiroRemoteSlot *s;
+  int i, j;
+  for (i = j = 0; i < m->nrslot; ++i) {
+    s = m->rslot + i;
+    if (!s->twin) {
+      m->rslot[j++] = *s;
+      continue;
+    }
+    ShiroRemoteLock(m, s->id, 0, 0);
+    shiro_shm_diff(s->id, s->off, s->host, s->twin, 4096);
+    ShiroRemoteUnlock(m, s->id, 0, 0);
+    free(s->twin);
+  }
+  m->nrslot = j;
+}
+
+void ShiroRemoteFlush(struct Machine *m) {
+  ShiroRemoteFlushTwins(m);
+  ShiroRemoteRelease(m);
+}
+
+// The end of an instruction (CommitStash) or a compiled region's start: a
+// system call's pages go back; an instruction's stay, locked, for the next
+// instructions (a lease) unless it has run out
+void ShiroRemoteEnd(struct Machine *m) {
+  int i;
+  for (i = 0; i < m->nrslot; ++i) {
+    if (m->rslot[i].twin) {
+      ShiroRemoteFlushTwins(m);
+      break;
+    }
+  }
+  if (!m->nrlocks) return;
+  if (emscripten_get_now() - m->rlockt < kShiroLeaseMs) {
+    m->stashaddr = SHIRO_STASH_REMOTE;  // (so the next instruction looks again)
+  } else {
+    ShiroRemoteRelease(m);
+  }
+}
+
+static void ShiroRemoteOnGil(void) {
+  struct Machine *m = g_machine;
+  if (m && m->nrlocks) ShiroRemoteRelease(m);
+}
+
+// VirtualCopy of n bytes (within one page) at remote `v`
+int ShiroRemoteCopy(struct Machine *m, i64 v, void *buf, u64 n, bool d) {
+  i64 page = v & -4096;
+  u8 *p;
+  u32 off;
+  int i, id;
+  for (i = 0; i < m->nrslot; ++i) {
+    if (m->rslot[i].page == page) {  // this instruction has it: the shadow
+      p = m->rslot[i].host + (v & 4095);
+      if (d) {
+        memcpy(buf, p, n);
+      } else {
+        memcpy(p, buf, n);
+      }
+      return 0;
+    }
+  }
+  if (!ShiroRemoteFind(m->system->pid, page, &id, &off)) return efault();
+  off += v & 4095;
+  if (d) {
+    shiro_shm_io(id, off, buf, n, 0);
+  } else if (ShiroRemoteLock(m, id, 0, 0)) {
+    shiro_shm_io(id, off, buf, n, 1);
+    ShiroRemoteUnlock(m, id, 0, 0);
+  } else {
+    shiro_shm_io(id, off, buf, n, 1);
+  }
+  return 0;
+}
+
+static void ShiroRemoteObjRelease(struct Machine *m, struct ShiroRemoteObj *o) {
+  if (--o->refs) return;
+  KS(m, 1021, A12(o->id));
+  free(o);
+}
+
+// [addr, addr + size) of `pid` no longer maps remote objects
+static void ShiroRemoteDrop(struct Machine *m, int pid, i64 addr, i64 size) {
+  struct ShiroRemoteMap **pp, *r, *r2, *gone = 0;
+  i64 end = addr + size;
+  LOCK(&g_shiro_remote_lock);
+  for (pp = &g_shiro_remote; (r = *pp);) {
+    if (r->pid != pid || r->addr >= end || addr >= r->addr + r->size) {
+      pp = &r->next;
+      continue;
+    }
+    if (addr <= r->addr && r->addr + r->size <= end) {
+      *pp = r->next;
+      r->next = gone;
+      gone = r;
+      continue;
+    }
+    if (r->addr < addr && end < r->addr + r->size &&
+        (r2 = (struct ShiroRemoteMap *)malloc(sizeof(*r2)))) {
+      *r2 = *r;  // a hole in the middle: the part above it
+      r2->off += (u32)(end - r->addr);
+      r2->size = r->addr + r->size - end;
+      r2->addr = end;
+      ++r2->obj->refs;
+      r->next = r2;
+    }
+    if (r->addr < addr) {
+      r->size = addr - r->addr;
+    } else {
+      r->off += (u32)(end - r->addr);
+      r->size = r->addr + r->size - end;
+      r->addr = end;
+    }
+    pp = &r->next;
+  }
+  UNLOCK(&g_shiro_remote_lock);
+  while ((r = gone)) {
+    gone = r->next;
+    ShiroRemoteObjRelease(m, r->obj);
+    free(r);
+  }
+}
+
+// same-instance fork: the child maps what the parent maps
+static void ShiroRemoteFork(int parent, int child) {
+  struct ShiroRemoteMap *r, *r2;
+  LOCK(&g_shiro_remote_lock);
+  for (r = g_shiro_remote; r; r = r->next) {
+    if (r->pid != parent || !(r2 = (struct ShiroRemoteMap *)malloc(sizeof(*r2)))) continue;
+    *r2 = *r;
+    r2->pid = child;
+    ++r2->obj->refs;
+    r2->next = r->next;  // (after r: the walk skips it)
+    r->next = r2;
+    r = r2;
+  }
+  UNLOCK(&g_shiro_remote_lock);
+}
+
+// mmap(MAP_SHARED) of `fd`: remote pages if it is a shareable object, else
+// SHIRO_NOT_REMOTE
+static i64 ShiroRemoteMapFile(struct Machine *m, i64 virt, u64 size, int prot,
+                              int flags, int fd, i64 off) {
+  struct ShiroRemoteObj *o;
+  struct ShiroRemoteMap *r;
+  i64 id, addr, end = off + (i64)size, v, rc;
+  u8 out[4] = {0}, *slot;
+  u64 e;
+  if (g_shiro_noremote || end > 0xfffff000) return SHIRO_NOT_REMOTE;
+  id = ShiroCall(m, 1020, A12(fd, 0x100, (int)end, (int)(end >> 32)), out, 0, 4, false, false);
+  if (id <= 0) return SHIRO_NOT_REMOTE;  // not a shareable object (or an older kernel)
+  if (!Read32(out)) {                    // (a kernel that would want a publish)
+    KS(m, 1021, A12((int)id));
+    return SHIRO_NOT_REMOTE;
+  }
+  if (!(o = (struct ShiroRemoteObj *)calloc(1, sizeof(*o))) ||
+      !(r = (struct ShiroRemoteMap *)calloc(1, sizeof(*r)))) {
+    free(o);
+    KS(m, 1021, A12((int)id));
+    return -ENOMEM_LINUX;
+  }
