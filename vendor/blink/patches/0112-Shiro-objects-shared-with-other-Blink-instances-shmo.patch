+// futex on a remote word: waits and wakes on the buffer (true: handled;
+// *res as SysFutex returns it)
+static bool ShiroRemoteFutex(struct Machine *m, i64 uaddr, int op, u32 val,
+                             i64 timeout_addr, int *res) {
+  struct timespec now, end;
+  bool absolute;
+  u8 ts[16];
+  u32 off;
+  int id, r, ms;
+  clockid_t clk = CLOCK_MONOTONIC;
+  if (!g_shiro_remote || !(FindPageTableEntry(m, uaddr & -4096) & PAGE_REMOTE) ||
+      !ShiroRemoteFind(m->system->pid, uaddr & -4096, &id, &off)) {
+    return false;
+  }
+  off += uaddr & 4095;
+  switch (op & ~FUTEX_CLOCK_REALTIME_LINUX) {
+    case FUTEX_WAKE_LINUX:
+    case FUTEX_WAKE_BITSET_LINUX:
+      *res = shiro_shm_wake(id, off, (int)MIN(val, 0x7fffffff));
+      return true;
+    case FUTEX_WAIT_LINUX:
+    case FUTEX_WAIT_BITSET_LINUX:
+      break;
+    default:
+      LOGF("futex op %#x on a shared object's word isn't supported", op);
+      *res = (int)enosys();
+      return true;
+  }
+  absolute = (op & ~FUTEX_CLOCK_REALTIME_LINUX) == FUTEX_WAIT_BITSET_LINUX;
+  if (absolute && (op & FUTEX_CLOCK_REALTIME_LINUX)) clk = CLOCK_REALTIME;
+  end = GetMaxTime();
+  if (timeout_addr) {
+    if (CopyFromUserRead(m, ts, timeout_addr, 16) == -1) {
+      *res = (int)efault();
+      return true;
+    }
+    end.tv_sec = Read64(ts);
+    end.tv_nsec = Read64(ts + 8);
+    if (!(0 <= end.tv_nsec && end.tv_nsec < 1000000000)) {
+      *res = (int)einval();
+      return true;
+    }
+    if (!absolute) {
+      unassert(!clock_gettime(clk, &now));
+      end = AddTime(now, end);
+    }
+  }
+  for (;;) {
+    if (m->killed) {
+      *res = (int)eagain();
+      return true;
+    }
+    if (CheckInterrupt(m, true)) {
+      *res = (int)eintr();
+      return true;
+    }
+    unassert(!clock_gettime(clk, &now));
+    if (CompareTime(now, end) >= 0) {
+      errno = ETIMEDOUT;
+      *res = -1;
+      return true;
+    }
+    ms = kPollingMs;
+    if (CompareTime(SubtractTime(end, now), FromMilliseconds(ms)) < 0) {
+      ms = (int)ToMilliseconds(SubtractTime(end, now)) + 1;
+    }
+    m->rflag = 0;
+    r = shiro_shm_watch(id, off, val, &m->rflag, ms);
+    if (r == -11) {  // the word isn't `val`
+      *res = (int)eagain();
+      return true;
+    }
+    if (r) {  // no Atomics.waitAsync: poll
+      u32 cur = 0;
+      shiro_shm_io(id, off, &cur, 4, 0);
+      if (cur != val) {
+        *res = 0;
+        return true;
+      }
+      usleep(1000);
+      continue;
+    }
+    while (!atomic_load_explicit((_Atomic(int) *)&m->rflag, memory_order_acquire)) {
+      emscripten_futex_wait(&m->rflag, 0, ms + 1000);
+    }
+    if (m->rflag == 2) {  // woken
+      *res = 0;
+      return true;
+    }
+  }
+}
