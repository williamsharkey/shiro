From 4c97a4c2d298deffb224910091162b8bf9074285 Mon Sep 17 00:00:00 2001
From: Shiro <shiro@localhost>
Date: Thu, 8 Oct 2026 04:56:59 +0000
Subject: [PATCH] emscripten: Shiro file mmap doesn't take mmap_lock twice
 (deadlock mapping a kernel fd)

---
 blink/shiro.inc | 6 +-----
 1 file changed, 1 insertion(+), 5 deletions(-)

diff --git a/blink/shiro.inc b/blink/shiro.inc
index c3f05a4..57014fc 100644
--- a/blink/shiro.inc
+++ b/blink/shiro.inc
@@ -1501,11 +1501,7 @@ static bool ShiroSyscall(struct Machine *m, int nr, u64 a, u64 b, u64 c,
     }
     case 0x009:                                                       // mmap
       if ((d & 0x20) || (i64)e < 0) return false;
-      BEGIN_NO_PAGE_FAULTS;
-      LOCK(&m->system->mmap_lock);
-      r = ShiroMmapFile(m, a, b, c, d, e, f);
-      UNLOCK(&m->system->mmap_lock);
-      END_NO_PAGE_FAULTS;
+      r = ShiroMmapFile(m, a, b, c, d, e, f);  // SysMmap/SysMprotect take mmap_lock
       break;
     case 0x00B:                                                       // munmap
       if (g_shiro_maps) ShiroSyncMaps(m, a, b, true);
-- 
