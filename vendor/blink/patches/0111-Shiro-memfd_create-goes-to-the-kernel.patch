From baeb3bf4d809090b7f0f29dc2a985c826a9f9edf Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 07:33:28 +0000
Subject: [PATCH 111/111] Shiro: memfd_create goes to the kernel

---
 blink/shiro.inc | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/blink/shiro.inc b/blink/shiro.inc
index 60384b8..697533c 100644
--- a/blink/shiro.inc
+++ b/blink/shiro.inc
@@ -3680,7 +3680,16 @@ static bool ShiroSyscall(struct Machine *m, int nr, u64 a, u64 b, u64 c,
       break;
     }
     case 0x146: r = -ENOSYS_LINUX; break;                             // copy_file_range
-    case 0x13F: r = -ENOSYS_LINUX; break;                             // memfd_create
+    case 0x13F: {                                                     // memfd_create
+      // the kernel's anonymous in-memory file (Firefox's shared memory,
+      // Mesa, Wayland, PulseAudio); a kernel without it is ENOSYS
+      char *name;
+      int n;
+      if (!(name = LoadStr(m, a))) { r = -EFAULT_LINUX; break; }
+      if ((n = strlen(name)) > 249) { r = -EINVAL_LINUX; break; }
+      r = ShiroCall(m, 319, A12(n, (int)b), name, n, 0, false, false);
+      break;
+    }
     case 0x085:  // mknod: FIFOs and regular files (the kernel refuses devices)
     case 0x103:  // mknodat
       r = nr == 0x085 ? ShiroAtCall(m, 259, AT_FDCWD_LINUX, a, b, c)
-- 
