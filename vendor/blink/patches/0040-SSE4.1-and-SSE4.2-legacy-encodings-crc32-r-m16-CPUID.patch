+  const u8 *y;
+  double t[2], s;
+  int i;
+  NEED_OSZ;
+  x = Dst(A);
+  y = GetXmmAddress(A);
+  for (i = 0; i < 2; ++i) {
+    t[i] = (uimm0 & (0x10 << i)) ? G(x, i) * G(y, i) : +0.;
+  }
+  s = t[0] + t[1];
+  for (i = 0; i < 2; ++i) PutG(x, i, (uimm0 & (1 << i)) ? s : +0.);
+}
