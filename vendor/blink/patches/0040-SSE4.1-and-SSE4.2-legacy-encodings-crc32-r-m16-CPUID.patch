+// SSE4.1 and SSE4.2 (the legacy 66 0F 38 xx and 66 0F 3A xx encodings).
+// Operands are read and written through Read/Write helpers, so this is
+// byte order independent; m128 operands must be aligned as usual, except
+// for the string compares, and the narrow ones (pmovsx/zx, pinsr/pextr,
+// insertps, roundss/sd) may be unaligned.
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "blink/bitscan.h"
+#include "blink/endian.h"
+#include "blink/flags.h"
+#include "blink/macros.h"
+#include "blink/machine.h"
+#include "blink/modrm.h"
+#include "blink/rde.h"
+
+#define B(p, i)  ((p)[i])
+#define SB(p, i) ((i8)(p)[i])
+#define W(p, i)  Read16((p) + 2 * (i))
+#define SW(p, i) ((i16)Read16((p) + 2 * (i)))
+#define D(p, i)  Read32((p) + 4 * (i))
+#define SD(p, i) ((i32)Read32((p) + 4 * (i)))
+#define Q(p, i)  Read64((p) + 8 * (i))
+#define SQ(p, i) ((i64)Read64((p) + 8 * (i)))
+
+static float F(const u8 *p, int i) {
+  u32 u = D(p, i);
+  float f;
+  memcpy(&f, &u, 4);
+  return f;
+}
+static double G(const u8 *p, int i) {
+  u64 u = Q(p, i);
+  double f;
+  memcpy(&f, &u, 8);
+  return f;
+}
+static void PutF(u8 *p, int i, float f) {
+  u32 u;
+  memcpy(&u, &f, 4);
+  Write32(p + 4 * i, u);
+}
+static void PutG(u8 *p, int i, double f) {
+  u64 u;
+  memcpy(&u, &f, 8);
+  Write64(p + 8 * i, u);
+}
+
+// the destination xmm register (ModRM reg)
+static u8 *Dst(P) {
+  return XmmRexrReg(m, rde);
+}
+
+// an n-byte source that may be unaligned: xmm register or memory
+static const u8 *Src(P, size_t n) {
+  if (IsModrmRegister(rde)) return XmmRexbRm(m, rde);
+  return ComputeReserveAddressRead(A, n);
+}
+
+// legacy SSE instructions without the 66 prefix (no MMX forms here)
+#define NEED_OSZ        \
+  if (!Osz(rde)) {      \
+    OpUdImpl(m);        \
+    return;             \
+  }
+
+////////////////////////////////////////////////////////////////////////////////
+// 66 0F 38
+
+static void Blendv(P, int size) {
+  u8 r[16], *x = Dst(A);
+  const u8 *y = GetXmmAddress(A), *k = m->xmm[0];
+  int i;
+  for (i = 0; i < 16; ++i) {
+    r[i] = (k[(i | (size - 1))] & 0x80) ? y[i] : x[i];
+  }
+  memcpy(x, r, 16);
+}
+void OpSsePblendvb(P) {
+  NEED_OSZ;
+  Blendv(A, 1);
+}
+void OpSseBlendvps(P) {
+  NEED_OSZ;
+  Blendv(A, 4);
+}
+void OpSseBlendvpd(P) {
+  NEED_OSZ;
+  Blendv(A, 8);
+}
+
+void OpSsePtest(P) {
+  const u8 *x, *y;
+  NEED_OSZ;
+  x = Dst(A);
+  y = GetXmmAddress(A);
+  m->flags = SetFlag(m->flags, FLAGS_ZF, !((Q(x, 0) & Q(y, 0)) |  //
+                                           (Q(x, 1) & Q(y, 1))));
+  m->flags = SetFlag(m->flags, FLAGS_CF, !((~Q(x, 0) & Q(y, 0)) |  //
+                                           (~Q(x, 1) & Q(y, 1))));
+  m->flags = SetFlag(m->flags, FLAGS_OF, false);
+  m->flags = SetFlag(m->flags, FLAGS_SF, false);
+  m->flags = SetFlag(m->flags, FLAGS_AF, false);
+  m->flags = SetFlag(m->flags, FLAGS_PF, false);
+}
+
+// pmovsx/pmovzx: `n` elements of `from` bytes widened to `to` bytes
+static void Pmovx(P, int from, int to, bool sign) {
+  u8 r[16];
+  const u8 *y;
+  int i, n = 16 / to;
+  i64 v;
+  NEED_OSZ;
+  y = Src(A, n * from);
+  for (i = 0; i < n; ++i) {
+    switch (from) {
+      case 1:
+        v = sign ? SB(y, i) : B(y, i);
+        break;
+      case 2:
+        v = sign ? SW(y, i) : W(y, i);
+        break;
+      default:
+        v = sign ? (i64)SD(y, i) : (i64)D(y, i);
+        break;
+    }
+    switch (to) {
+      case 2:
+        Write16(r + 2 * i, v);
+        break;
+      case 4:
+        Write32(r + 4 * i, v);
+        break;
+      default:
+        Write64(r + 8 * i, v);
+        break;
+    }
+  }
+  memcpy(Dst(A), r, 16);
+}
+void OpSsePmovsxbw(P) {
+  Pmovx(A, 1, 2, true);
+}
+void OpSsePmovsxbd(P) {
+  Pmovx(A, 1, 4, true);
+}
+void OpSsePmovsxbq(P) {
+  Pmovx(A, 1, 8, true);
+}
+void OpSsePmovsxwd(P) {
+  Pmovx(A, 2, 4, true);
+}
+void OpSsePmovsxwq(P) {
+  Pmovx(A, 2, 8, true);
+}
+void OpSsePmovsxdq(P) {
+  Pmovx(A, 4, 8, true);
+}
+void OpSsePmovzxbw(P) {
+  Pmovx(A, 1, 2, false);
+}
+void OpSsePmovzxbd(P) {
+  Pmovx(A, 1, 4, false);
+}
+void OpSsePmovzxbq(P) {
+  Pmovx(A, 1, 8, false);
+}
+void OpSsePmovzxwd(P) {
+  Pmovx(A, 2, 4, false);
+}
+void OpSsePmovzxwq(P) {
+  Pmovx(A, 2, 8, false);
+}
+void OpSsePmovzxdq(P) {
+  Pmovx(A, 4, 8, false);
+}
+
+void OpSsePmuldq(P) {
+  u8 *x;
+  const u8 *y;
+  NEED_OSZ;
+  x = Dst(A);
+  y = GetXmmAddress(A);
+  i64 a = (i64)SD(x, 0) * SD(y, 0);
+  i64 b = (i64)SD(x, 2) * SD(y, 2);
+  Write64(x, a);
+  Write64(x + 8, b);
+}
+
+void OpSsePcmpeqq(P) {
+  u8 *x;
+  const u8 *y;
+  NEED_OSZ;
+  x = Dst(A);
+  y = GetXmmAddress(A);
+  Write64(x, Q(x, 0) == Q(y, 0) ? -1 : 0);
+  Write64(x + 8, Q(x, 1) == Q(y, 1) ? -1 : 0);
+}
+
+void OpSsePcmpgtq(P) {
+  u8 *x;
+  const u8 *y;
+  NEED_OSZ;
+  x = Dst(A);
+  y = GetXmmAddress(A);
+  Write64(x, SQ(x, 0) > SQ(y, 0) ? -1 : 0);
+  Write64(x + 8, SQ(x, 1) > SQ(y, 1) ? -1 : 0);
+}
+
+void OpSsePackusdw(P) {
+  u8 r[16], *x;
+  const u8 *y;
+  int i;
+  i32 v;
+  NEED_OSZ;
+  x = Dst(A);
+  y = GetXmmAddress(A);
+  for (i = 0; i < 8; ++i) {
+    v = i < 4 ? SD(x, i) : SD(y, i - 4);
+    Write16(r + 2 * i, v < 0 ? 0 : v > 65535 ? 65535 : v);
+  }
+  memcpy(x, r, 16);
+}
+
+// pmin/pmax: MAX 0 for min, 1 for max
+#define MINMAX(NAME, N, GET, PUT, MAX)       \
+  void NAME(P) {                             \
+    u8 *x;                                   \
+    const u8 *y;                             \
+    int i;                                   \
+    NEED_OSZ;                                \
+    x = Dst(A);                              \
+    y = GetXmmAddress(A);                    \
+    for (i = 0; i < N; ++i) {                \
+      if (MAX ? GET(y, i) > GET(x, i)        \
+              : GET(y, i) < GET(x, i)) {     \
+        PUT;                                 \
+      }                                      \
+    }                                        \
+  }
+MINMAX(OpSsePminsb, 16, SB, x[i] = y[i], 0)
+MINMAX(OpSsePmaxsb, 16, SB, x[i] = y[i], 1)
+MINMAX(OpSsePminuw, 8, W, Write16(x + 2 * i, W(y, i)), 0)
+MINMAX(OpSsePmaxuw, 8, W, Write16(x + 2 * i, W(y, i)), 1)
+MINMAX(OpSsePminsd, 4, SD, Write32(x + 4 * i, D(y, i)), 0)
+MINMAX(OpSsePmaxsd, 4, SD, Write32(x + 4 * i, D(y, i)), 1)
+MINMAX(OpSsePminud, 4, D, Write32(x + 4 * i, D(y, i)), 0)
+MINMAX(OpSsePmaxud, 4, D, Write32(x + 4 * i, D(y, i)), 1)
+
+void OpSsePhminposuw(P) {
+  u8 r[16] = {0};
+  const u8 *y;
+  int i, k = 0;
+  NEED_OSZ;
+  y = GetXmmAddress(A);
+  for (i = 1; i < 8; ++i) {
+    if (W(y, i) < W(y, k)) k = i;
+  }
+  Write16(r, W(y, k));
+  Write16(r + 2, k);
+  memcpy(Dst(A), r, 16);
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// 66 0F 3A
+
+// imm8[2] picks MXCSR.RC, else imm8[1:0]: nearest even, down, up, truncate
+static int RoundingMode(struct Machine *m, int imm) {
+  return imm & 4 ? (m->mxcsr >> 13) & 3 : imm & 3;
+}
+static double RoundEven(double x) {
+  double r = round(x);
+  if (fabs(x - trunc(x)) == 0.5) r = 2.0 * round(x / 2.0);
+  return r;
+}
+static float RoundEvenf(float x) {
+  float r = roundf(x);
+  if (fabsf(x - truncf(x)) == 0.5f) r = 2.0f * roundf(x / 2.0f);
+  return r;
+}
+static double RoundG(double x, int mode) {
+  switch (mode) {
+    case 0:
+      return RoundEven(x);
+    case 1:
+      return floor(x);
+    case 2:
+      return ceil(x);
+    default:
+      return trunc(x);
+  }
+}
+static float RoundF(float x, int mode) {
+  switch (mode) {
+    case 0:
+      return RoundEvenf(x);
+    case 1:
+      return floorf(x);
+    case 2:
+      return ceilf(x);
+    default:
+      return truncf(x);
+  }
+}
+
+void OpSseRoundps(P) {
+  u8 r[16];
+  const u8 *y;
+  int i, mode;
+  NEED_OSZ;
+  y = GetXmmAddress(A);
+  mode = RoundingMode(m, uimm0);
+  for (i = 0; i < 4; ++i) PutF(r, i, RoundF(F(y, i), mode));
+  memcpy(Dst(A), r, 16);
+}
+void OpSseRoundpd(P) {
+  u8 r[16];
+  const u8 *y;
+  int i, mode;
+  NEED_OSZ;
+  y = GetXmmAddress(A);
+  mode = RoundingMode(m, uimm0);
+  for (i = 0; i < 2; ++i) PutG(r, i, RoundG(G(y, i), mode));
+  memcpy(Dst(A), r, 16);
+}
+void OpSseRoundss(P) {
+  NEED_OSZ;
+  PutF(Dst(A), 0, RoundF(F(Src(A, 4), 0), RoundingMode(m, uimm0)));
+}
+void OpSseRoundsd(P) {
+  NEED_OSZ;
+  PutG(Dst(A), 0, RoundG(G(Src(A, 8), 0), RoundingMode(m, uimm0)));
+}
+
+static void Blend(P, int size) {
+  u8 *x;
+  const u8 *y;
+  int i;
+  x = Dst(A);
+  y = GetXmmAddress(A);
+  for (i = 0; i < 16 / size; ++i) {
+    if (uimm0 & (1 << i)) memcpy(x + i * size, y + i * size, size);
+  }
+}
+void OpSseBlendps(P) {
+  NEED_OSZ;
+  Blend(A, 4);
+}
+void OpSseBlendpd(P) {
+  NEED_OSZ;
+  Blend(A, 8);
+}
+void OpSsePblendw(P) {
+  NEED_OSZ;
+  Blend(A, 2);
+}
+
+// pextrb/pextrw/pextrd/pextrq/extractps: to a general register (zero
+// extended to 64 bits) or to memory
+static void Extract(P, u64 v, int size) {
+  if (IsModrmRegister(rde)) {
+    Put64(RegRexbRm(m, rde), v);
+  } else {
+    u8 *p = ComputeReserveAddressWrite(A, size);
+    switch (size) {
+      case 1:
+        *p = v;
+        break;
+      case 2:
+        Write16(p, v);
+        break;
+      case 4:
+        Write32(p, v);
+        break;
+      default:
+        Write64(p, v);
+        break;
+    }
+  }
+}
+void OpSsePextrb(P) {
+  NEED_OSZ;
+  Extract(A, B(Dst(A), uimm0 & 15), 1);
+}
+void OpSsePextrw(P) {
+  NEED_OSZ;
+  Extract(A, W(Dst(A), uimm0 & 7), 2);
+}
+void OpSsePextrdq(P) {
+  NEED_OSZ;
+  if (Rexw(rde)) {
+    Extract(A, Q(Dst(A), uimm0 & 1), 8);
+  } else {
+    Extract(A, D(Dst(A), uimm0 & 3), 4);
+  }
+}
+void OpSseExtractps(P) {
+  NEED_OSZ;
+  Extract(A, D(Dst(A), uimm0 & 3), 4);
+}
+
+// pinsrb/pinsrd/pinsrq: from a general register or memory
+static const u8 *InsertSource(P, int size) {
+  if (IsModrmRegister(rde)) return RegRexbRm(m, rde);
+  return ComputeReserveAddressRead(A, size);
+}
