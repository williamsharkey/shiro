+  int i;
+  NEED_OSZ;
+  x = Dst(A);
+  y = GetXmmAddress(A);
+  for (i = 0; i < 4; ++i) {
+    t[i] = (uimm0 & (0x10 << i)) ? F(x, i) * F(y, i) : +0.f;
+  }
+  s = (t[0] + t[1]) + (t[2] + t[3]);
+  for (i = 0; i < 4; ++i) PutF(x, i, (uimm0 & (1 << i)) ? s : +0.f);
+}
+void OpSseDppd(P) {
