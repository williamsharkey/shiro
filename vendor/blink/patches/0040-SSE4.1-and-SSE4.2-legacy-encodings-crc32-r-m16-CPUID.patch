+void OpSseMpsadbw(P) {
+  u8 r[16], *x;
+  const u8 *y;
+  int i, j, a, b, sum;
+  NEED_OSZ;
+  x = Dst(A);
+  y = GetXmmAddress(A);
+  a = (uimm0 & 4) ? 4 : 0;
+  b = (uimm0 & 3) * 4;
