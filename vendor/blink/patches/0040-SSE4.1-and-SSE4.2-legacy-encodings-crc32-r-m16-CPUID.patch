+////////////////////////////////////////////////////////////////////////////////
+// SSE4.2 string compares: pcmpestri, pcmpestrm, pcmpistri, pcmpistrm
+
+// element i of a string operand in the format imm8[1:0] selects
+static int StrElem(const u8 *p, int imm, int i) {
+  switch (imm & 3) {
+    case 0:
+      return B(p, i);
+    case 1:
+      return W(p, i);
+    case 2:
+      return SB(p, i);
+    default:
+      return SW(p, i);
+  }
+}
+
+// explicit length from rax/rdx (eax/edx without REX.W), saturated
+static int ExplicitLength(P, u8 *reg, int upper) {
+  i64 v = Rexw(rde) ? (i64)Read64(reg) : (i32)Read32(reg);
+  if (v > upper || v < -upper) return upper;
+  return v < 0 ? -v : v;
+}
+
+// implicit length: up to the first zero element
+static int ImplicitLength(const u8 *p, int imm, int upper) {
+  int n = 0;
+  while (n < upper && StrElem(p, imm, n)) ++n;
+  return n;
+}
+
+// the comparison (Intel SDM "PCMPESTRI"; the structure follows QEMU): a is
+// the register operand, b the r/m one; returns IntRes2 and sets the flags
+static unsigned PcmpStr(struct Machine *m, const u8 *a, const u8 *b, int imm,
+                        int la, int lb) {
+  unsigned res = 0;
+  int i, j, v, upper = imm & 1 ? 7 : 15;
+  int va = la - 1, vb = lb - 1;  // last valid index
+  switch ((imm >> 2) & 3) {
+    case 0:  // equal any
+      for (j = vb; j >= 0; --j) {
+        res <<= 1;
+        v = StrElem(b, imm, j);
+        for (i = va; i >= 0; --i) res |= v == StrElem(a, imm, i);
+      }
+      break;
+    case 1:  // ranges
+      for (j = vb; j >= 0; --j) {
+        res <<= 1;
+        v = StrElem(b, imm, j);
+        for (i = ((va - 1) | 1); i >= 0; i -= 2) {
+          res |= StrElem(a, imm, i) >= v && StrElem(a, imm, i - 1) <= v;
+        }
+      }
+      break;
+    case 2:  // equal each
+      res = (1u << (upper - MAX(va, vb))) - 1;
+      res <<= MAX(va, vb) - MIN(va, vb);
+      for (i = MIN(va, vb); i >= 0; --i) {
+        res <<= 1;
+        res |= StrElem(b, imm, i) == StrElem(a, imm, i);
+      }
+      break;
+    default:  // equal ordered
+      if (va == -1) {
+        res = (2u << upper) - 1;
+        break;
+      }
+      for (j = vb == upper ? vb : vb - va; j >= 0; --j) {
+        res <<= 1;
+        v = 1;
+        for (i = MIN(vb - j, va); i >= 0; --i) {
+          v &= StrElem(b, imm, i + j) == StrElem(a, imm, i);
+        }
+        res |= v;
+      }
+      break;
+  }
+  switch ((imm >> 4) & 3) {
+    case 1:  // negative polarity
+      res ^= (2u << upper) - 1;
+      break;
+    case 3:  // masked negative: only the valid elements of b
+      res ^= (1u << (vb + 1)) - 1;
+      break;
+    default:
+      break;
+  }
+  res &= (2u << upper) - 1;
+  m->flags = SetFlag(m->flags, FLAGS_CF, res != 0);
+  m->flags = SetFlag(m->flags, FLAGS_ZF, vb < upper);
+  m->flags = SetFlag(m->flags, FLAGS_SF, va < upper);
+  m->flags = SetFlag(m->flags, FLAGS_OF, res & 1);
+  m->flags = SetFlag(m->flags, FLAGS_AF, false);
+  m->flags = SetFlag(m->flags, FLAGS_PF, false);
+  return res;
+}
+
+static void PcmpStrIndex(P, unsigned res) {
+  int upper = uimm0 & 1 ? 8 : 16;
+  u32 index;
+  if (!res) {
+    index = upper;
+  } else if (uimm0 & 0x40) {
+    index = bsr(res);  // most significant
+  } else {
+    index = bsf(res);  // least significant
+  }
+  Put64(m->cx, index);
+}
+
+static void PcmpStrMask(P, unsigned res) {
+  u8 r[16] = {0};
+  int i, n = uimm0 & 1 ? 8 : 16;
+  if (uimm0 & 0x40) {
+    for (i = 0; i < n; ++i) {
+      if (res & (1u << i)) {
+        if (n == 8) {
+          Write16(r + 2 * i, 0xffff);
+        } else {
+          r[i] = 0xff;
+        }
+      }
+    }
+  } else {
+    Write16(r, res);
+  }
+  memcpy(m->xmm[0], r, 16);
+}
+
+static unsigned Pcmpestr(P) {
+  const u8 *a = Dst(A), *b = GetModrmRegisterXmmPointerRead16(A);
+  int upper = uimm0 & 1 ? 8 : 16;
+  return PcmpStr(m, a, b, uimm0, ExplicitLength(A, m->ax, upper),
+                 ExplicitLength(A, m->dx, upper));
+}
+static unsigned Pcmpistr(P) {
+  const u8 *a = Dst(A), *b = GetModrmRegisterXmmPointerRead16(A);
+  int upper = uimm0 & 1 ? 8 : 16;
+  return PcmpStr(m, a, b, uimm0, ImplicitLength(a, uimm0, upper),
+                 ImplicitLength(b, uimm0, upper));
+}
+void OpSsePcmpestrm(P) {
+  NEED_OSZ;
+  PcmpStrMask(A, Pcmpestr(A));
+}
+void OpSsePcmpestri(P) {
+  NEED_OSZ;
+  PcmpStrIndex(A, Pcmpestr(A));
+}
+void OpSsePcmpistrm(P) {
+  NEED_OSZ;
+  PcmpStrMask(A, Pcmpistr(A));
+}
+void OpSsePcmpistri(P) {
+  NEED_OSZ;
+  PcmpStrIndex(A, Pcmpistr(A));
+}
