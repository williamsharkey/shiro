From e87142be52b6da77512a991140c3e8e21513e91f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 9 Oct 2026 08:59:40 +0000
Subject: [PATCH 40/40] SSE4.1 and SSE4.2 (legacy encodings), crc32 r/m16;
 CPUID advertises them

---
 blink/cpuid.c   |   4 +-
 blink/crc32.c   |   4 +-
 blink/machine.c |  50 ++++
 blink/machine.h |  50 ++++
 blink/sse4.c    | 659 ++++++++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 763 insertions(+), 4 deletions(-)
 create mode 100644 blink/sse4.c

diff --git a/blink/cpuid.c b/blink/cpuid.c
index 597c7c6..9281cca 100644
--- a/blink/cpuid.c
+++ b/blink/cpuid.c
@@ -146,8 +146,8 @@ void OpCpuid(P) {
       dx |= 1 << 24;   // fxsave
       dx |= 1 << 25;   // sse
       dx |= 1 << 26;   // sse2
-      cx |= 0 << 19;   // sse4.1
-      cx |= 0 << 20;   // sse4.2
+      cx |= 1 << 19;   // sse4.1
+      cx |= 1 << 20;   // sse4.2
 #ifndef DISABLE_X87
       dx |= 1 << 0;  // fpu
 #endif
diff --git a/blink/crc32.c b/blink/crc32.c
index 83661d5..c72a978 100644
--- a/blink/crc32.c
+++ b/blink/crc32.c
@@ -68,8 +68,8 @@ static void OpCrc32(P) {
 void Op2f01(P) {
   if (!Rep(rde) && !Osz(rde)) {
     OpUdImpl(m);  // TODO: movbe
-  } else if (Rep(rde) == 2 && !Osz(rde)) {
-    OpCrc32(A);
+  } else if (Rep(rde) == 2) {
+    OpCrc32(A);  // 66 F2 0F 38 F1: crc32 r32, r/m16
   } else {
     OpUdImpl(m);
   }
