From 0e3e96e99d7de6a7e262b0704764e7e7cb921397 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 07:21:58 +0000
Subject: [PATCH 110/111] Shiro: a same-instance child's signals carry their
 siginfo too

---
 blink/shiro.inc | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/blink/shiro.inc b/blink/shiro.inc
index 1e428f9..60384b8 100644
--- a/blink/shiro.inc
+++ b/blink/shiro.inc
@@ -2400,6 +2400,23 @@ EMSCRIPTEN_KEEPALIVE int blink_shiro_sharedmaps(void) { return 1; }
 // 0099: mlock/munlock/mlockall and mmap answer bad arguments as Linux
 EMSCRIPTEN_KEEPALIVE int blink_shiro_memerrs(void) { return 1; }
 
+// the same with the signal's siginfo (the kernel's call 1030, made as `pid`)
+EMSCRIPTEN_KEEPALIVE void blink_shiro_signal_pid_info(int pid, int sig, int w0, int w1, int w2,
+                                                      int w3, int w4, int w5, int w6, int w7) {
+  const int w[8] = {w0, w1, w2, w3, w4, w5, w6, w7};
+  int i;
+  if (sig < 1 || sig > 64) return;
+  LOCK(&g_shiro_kids_lock);
+  for (i = 0; i < g_shiro_nkids; ++i) {
+    if (g_shiro_kids[i]->pid == pid) {
+      ShiroQueueSiginfo(g_shiro_kids[i], sig, w);
+      ShiroSignalSystem(g_shiro_kids[i], sig);
+      break;
+    }
+  }
+  UNLOCK(&g_shiro_kids_lock);
+}
+
 // the kernel signalled hosted child `pid` (host.mjs routes by pid)
 EMSCRIPTEN_KEEPALIVE void blink_shiro_signal_pid(int pid, int sig) {
   int i;
