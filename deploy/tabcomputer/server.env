# Environment for server.mjs on tabcomputer.com (systemd EnvironmentFile).
# Shipped with every release; no secrets here, this repo is public.

# Raw TCP relay at /tcp for guest sockets (docs/NETWORKING.md). Open for now;
# set SHIRO_TCP_REQUIRE_SIGNIN=1 to require a GitHub sign-in (docs/DESKTOP.md).
SHIRO_TCP_RELAY=1
SHIRO_TCP_ORIGINS=https://tabcomputer.com,https://www.tabcomputer.com
SHIRO_TCP_REQUIRE_SIGNIN=0
